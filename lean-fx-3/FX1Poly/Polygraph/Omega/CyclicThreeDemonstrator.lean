/-! ## Non-vacuity — the four legs are genuinely distinct, the peaks are modulo strict -/

/-- The `ssss` legs are structurally DISTINCT (whisker-right vs whisker-left). -/
theorem cyclicThreeOmegaSsssLegs_distinct :
    cellBeq cyclicThreeOmegaModeBeq cyclicThreeOmegaGenBeq
      cyclicThreeOmegaSsssLeftLeg cyclicThreeOmegaSsssRightLeg = false := rfl

/-- The `sssss` legs are structurally DISTINCT. -/
theorem cyclicThreeOmegaSssssLegs_distinct :
    cellBeq cyclicThreeOmegaModeBeq cyclicThreeOmegaGenBeq
      cyclicThreeOmegaSssssLeftLeg cyclicThreeOmegaSssssRightLeg = false := rfl

/-- The `ssss` peak spellings are structurally distinct (`((ss)s)s` vs `s((ss)s)`, spanning three
associations) — so parallelism holds only MODULO strict (the honest fragment boundary, exactly the
involution's `involutionLegs_notLiterallyParallel`). -/
theorem cyclicThreeOmegaSsssLegs_notLiterallyParallel :
    cellBeq cyclicThreeOmegaModeBeq cyclicThreeOmegaGenBeq
      (boundarySource cyclicThreeOmegaSsssLeftLeg)
      (boundarySource cyclicThreeOmegaSsssRightLeg) = false := rfl


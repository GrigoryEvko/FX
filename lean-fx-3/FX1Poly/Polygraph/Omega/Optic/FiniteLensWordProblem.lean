import FX1Poly.ComputerAlgebra.Semigroup.CommWordProblem

/-! # Finite lenses over finite sets — the get/put table word problem (`lgp` kit)

A **concrete lens** `S <-> A` between finite sets `[sourceSize] = {0,..,sourceSize-1}` and
`[aSize]` is a pair of lookup tables:

* `getTable : List Nat` of length `sourceSize`, entry `s` giving `get s : [aSize]`;
* `putTable : List Nat` of length `sourceSize * aSize`, entry `s * aSize + viewValue`
  (row-major) giving `put s viewValue : [sourceSize]`.

Everything is a finite function encoded as a `List Nat`, so a lens *is* its two tables:
two lenses are observationally equal iff the tables are structurally equal.  The whole
development is zero-axiom: structural indexing (`lgpListGet`, hand-rolled like
`bunchedBimonoidNatListGet`, NOT `List.getD` which leaks `propext`), a bounded structural
`forall` (`lgpBoundedAll`), a hand-rolled Boolean `<` (`lgpBlt`), and the reused
propext-clean `List Nat` equality kit (`cswListNatBeq` / `cswListNatBeqEq` /
`cswListNatBeqRefl` from `CommWordProblem`).

Contents:
* **T1** carrier `LgpLens`, structural indexer, `lgpGet` / `lgpPut`, `lgpIdentityLens`,
  `lgpLensCompose` (get-compose + the put chain rule), well-formedness `lgpIsWellFormed`.
* **T2** the three lens laws as decidable Booleans (`lgpIsGetPutLawful`,
  `lgpIsPutGetLawful`, `lgpIsPutPutLawful`), each a bounded structural fold; a *general*
  soundness bridge `lgpBoundedAllSound` -> `lgpGetPutSound` connecting the Boolean decision
  to the pointwise equation, plus concrete lawful / non-lawful fires.
* **T3** the word decision `lgpDecideLensConv` (table beq on both tables), the congruence
  `LgpLensConv` (an equivalence generated by table-equality), and BOTH halves:
  `lgpLensConvDecides` (soundness: convertible -> decides true) and
  `lgpDecideLensConvComplete` (decides true -> convertible), hence the refutation
  `lgpLensConvRefute` (decides false -> not convertible).
* **T4** two walls (`lgpHasGeneralOpticCompleteness`, `lgpHasPolyDoubleCoherence`) plus the
  borderline owner-false `lgpHasLawfulLensCompleteness`.

Forbidden in every shipped term: `propext`, `Quot.sound`, `Classical.choice`, `sorry`,
`native_decide`, `funext`, `WellFounded.fix`, `omega`, `decide`-on-`Prop`, wildcard match
arms over a split scrutinee. -/

namespace FX1Poly.Polygraph.Optic

open FX1Poly.ComputerAlgebra (cswBoolAndElim cswNatBeqEq cswNatBeqRefl
  cswListNatBeq cswListNatBeqEq cswListNatBeqRefl)

/-! ## Structural micro-kit: indexing, length, Boolean `<`, bounded `forall`, list builders -/

/-- Structural **`List Nat` indexing** — out-of-range reads `0`.  Hand-rolled (NOT `List.getD`,
which leaks `propext`): full structural recursion on the list then the index. -/
def lgpListGet : List Nat → Nat → Nat
  | [], _ => 0
  | head :: _, 0 => head
  | _ :: tail, index + 1 => lgpListGet tail index

/-- Structural length of a `List Nat`. -/
def lgpNatListLength : List Nat → Nat
  | [] => 0
  | _ :: tail => lgpNatListLength tail + 1

/-- Hand-rolled Boolean strict-less-than, fully structural (full-enum, propext-clean). -/
def lgpBlt : Nat → Nat → Bool
  | _, 0 => false
  | 0, _ + 1 => true
  | value + 1, bound + 1 => lgpBlt value bound

/-- Every entry of a `List Nat` is `< bound`. -/
def lgpEntriesBelow : List Nat → Nat → Bool
  | [], _ => true
  | head :: tail, bound => lgpBlt head bound && lgpEntriesBelow tail bound

/-- Bounded structural `forall`: `predicate` holds on every index `0,..,count-1`. -/
def lgpBoundedAll : Nat → (Nat → Bool) → Bool
  | 0, _ => true
  | count + 1, predicate => lgpBoundedAll count predicate && predicate count

/-- Hand-rolled cons-only `List Nat` append (NOT `List.++`, whose `reverse_cons` etc. leak). -/
def lgpAppend : List Nat → List Nat → List Nat
  | [], ys => ys
  | head :: tail, ys => head :: lgpAppend tail ys

/-- Hand-rolled structural map over a `List Nat`. -/
def lgpMap (transform : Nat → Nat) : List Nat → List Nat
  | [] => []
  | head :: tail => transform head :: lgpMap transform tail

/-- `[start, start+1, .., start+count-1]`. -/
def lgpRangeFrom (start : Nat) : Nat → List Nat
  | 0 => []
  | count + 1 => start :: lgpRangeFrom (start + 1) count

/-- `[0, 1, .., n-1]`. -/
def lgpRange (n : Nat) : List Nat := lgpRangeFrom 0 n

/-- One row of a built table: `[buildEntry rowIndex colStart, .., buildEntry rowIndex (colStart+count-1)]`. -/
def lgpBuildRowFrom (buildEntry : Nat → Nat → Nat) (rowIndex : Nat) (colStart : Nat) : Nat → List Nat
  | 0 => []
  | count + 1 => buildEntry rowIndex colStart :: lgpBuildRowFrom buildEntry rowIndex (colStart + 1) count

/-- A row-major flattened table of `rowCount` rows and `cols` columns, entry `(r,c) = buildEntry r c`. -/
def lgpBuildTableFrom (buildEntry : Nat → Nat → Nat) (cols : Nat) (rowStart : Nat) : Nat → List Nat
  | 0 => []
  | rowCount + 1 =>
      lgpAppend (lgpBuildRowFrom buildEntry rowStart 0 cols)
        (lgpBuildTableFrom buildEntry cols (rowStart + 1) rowCount)

/-- Row-major flattened `rows * cols` table with entry `(r,c) = buildEntry r c`. -/
def lgpBuildTable (rows cols : Nat) (buildEntry : Nat → Nat → Nat) : List Nat :=
  lgpBuildTableFrom buildEntry cols 0 rows

/-! ## T1 — the lens carrier and operations -/

/-- A concrete finite lens `[sourceSize] <-> [aSize]` as two lookup tables. -/
structure LgpLens where
  sourceSize : Nat
  aSize : Nat
  getTable : List Nat
  putTable : List Nat

/-- The lens's `get`: read `getTable` at the source index (out-of-range `0`). -/
def lgpGet (lens : LgpLens) (source : Nat) : Nat :=
  lgpListGet lens.getTable source

/-- The lens's `put`: read `putTable` at the row-major index `source * aSize + viewValue`. -/
def lgpPut (lens : LgpLens) (source viewValue : Nat) : Nat :=
  lgpListGet lens.putTable (source * lens.aSize + viewValue)

/-- Well-formedness as a decidable Boolean: table lengths and entry bounds.  Never carried
in the type — decided on demand, mirroring the csw / Groebner "default out of bounds"
convention that keeps the carrier kernel-clean. -/
def lgpIsWellFormed (lens : LgpLens) : Bool :=
  (lgpNatListLength lens.getTable == lens.sourceSize) &&
  (lgpNatListLength lens.putTable == lens.sourceSize * lens.aSize) &&
  lgpEntriesBelow lens.getTable lens.aSize &&
  lgpEntriesBelow lens.putTable lens.sourceSize

/-- The identity lens on `[n]`: `get s = s`, `put s a = a`. -/
def lgpIdentityLens (n : Nat) : LgpLens where
  sourceSize := n
  aSize := n
  getTable := lgpRange n
  putTable := lgpBuildTable n n (fun _ viewValue => viewValue)

/-- Composition `inner : S <-> A` then `outer : A <-> B` giving `S <-> B`:
`get = get_outer . get_inner`, `put s b = put_inner s (put_outer (get_inner s) b)`. -/
def lgpLensCompose (inner outer : LgpLens) : LgpLens where
  sourceSize := inner.sourceSize
  aSize := outer.aSize
  getTable := lgpMap (fun viewValue => lgpListGet outer.getTable viewValue) inner.getTable
  putTable :=
    lgpBuildTable inner.sourceSize outer.aSize
      (fun source outerValue => lgpPut inner source (lgpPut outer (lgpGet inner source) outerValue))

/-! ## T2 — the three lens laws as decisions -/

/-- GetPut: `put s (get s) = s` for every source `s < sourceSize`. -/
def lgpIsGetPutLawful (lens : LgpLens) : Bool :=
  lgpBoundedAll lens.sourceSize (fun source => Nat.beq (lgpPut lens source (lgpGet lens source)) source)

/-- PutGet: `get (put s a) = a` for every `s < sourceSize`, `a < aSize`. -/
def lgpIsPutGetLawful (lens : LgpLens) : Bool :=
  lgpBoundedAll lens.sourceSize (fun source =>
    lgpBoundedAll lens.aSize (fun viewValue =>
      Nat.beq (lgpGet lens (lgpPut lens source viewValue)) viewValue))

/-- PutPut: `put (put s a) b = put s b` for every `s < sourceSize`, `a b < aSize`. -/
def lgpIsPutPutLawful (lens : LgpLens) : Bool :=
  lgpBoundedAll lens.sourceSize (fun source =>
    lgpBoundedAll lens.aSize (fun firstValue =>
      lgpBoundedAll lens.aSize (fun secondValue =>
        Nat.beq (lgpPut lens (lgpPut lens source firstValue) secondValue) (lgpPut lens source secondValue))))

/-! ### Bridge: the Boolean decision reflects the pointwise property -/

/-- Nothing is `< 0`. -/
theorem lgpBltZeroRight : (index : Nat) → lgpBlt index 0 = false
  | 0 => rfl
  | _ + 1 => rfl

/-- `lgpBlt k (n+1) = true` splits into `k < n` or `k = n`. -/
theorem lgpBltSuccCases : (index bound : Nat) →
    lgpBlt index (bound + 1) = true → (lgpBlt index bound = true) ∨ (index = bound)
  | 0, 0, _ => Or.inr rfl
  | 0, _ + 1, _ => Or.inl rfl
  | value + 1, 0, hBlt => by
      rw [show lgpBlt (value + 1) (0 + 1) = lgpBlt value 0 from rfl, lgpBltZeroRight value] at hBlt
      exact Bool.noConfusion hBlt
  | value + 1, bound + 1, hBlt =>
      match lgpBltSuccCases value bound hBlt with
      | Or.inl hlt => Or.inl hlt
      | Or.inr heq => Or.inr (congrArg Nat.succ heq)

/-- Soundness of the bounded `forall`: if it decides `true`, the predicate holds at every in-range index. -/
theorem lgpBoundedAllSound : (count : Nat) → (predicate : Nat → Bool) →
    lgpBoundedAll count predicate = true →
    (index : Nat) → lgpBlt index count = true → predicate index = true
  | 0, _, _, index, hBlt => by rw [lgpBltZeroRight index] at hBlt; exact Bool.noConfusion hBlt
  | count + 1, predicate, hAll, index, hBlt =>
      let hSplit := cswBoolAndElim _ _ hAll
      match lgpBltSuccCases index count hBlt with
      | Or.inl hlt => lgpBoundedAllSound count predicate hSplit.left index hlt
      | Or.inr heq => by rw [heq]; exact hSplit.right

/-- Semantic soundness of the GetPut decision: a lawful lens satisfies `put s (get s) = s`
for every in-range source. -/
theorem lgpGetPutSound (lens : LgpLens) (hLaw : lgpIsGetPutLawful lens = true)
    (source : Nat) (hSource : lgpBlt source lens.sourceSize = true) :
    lgpPut lens source (lgpGet lens source) = source :=
  cswNatBeqEq _ _
    (lgpBoundedAllSound lens.sourceSize
      (fun s => Nat.beq (lgpPut lens s (lgpGet lens s)) s) hLaw source hSource)

/-! ## T3 — the word decision and the congruence -/

/-- Word decision: two lenses are equal iff both tables are structurally beq-equal. -/
def lgpDecideLensConv (left right : LgpLens) : Bool :=
  cswListNatBeq left.getTable right.getTable && cswListNatBeq left.putTable right.putTable

/-- The lens-expression congruence: the equivalence generated by table-equality.  Its
generators are exactly what a category-law rewriter produces after normalising to tables —
any two lens expressions with the same normal-form `(getTable, putTable)` are related. -/
inductive LgpLensConv : LgpLens → LgpLens → Prop where
  | ofTableEq (left right : LgpLens) :
      left.getTable = right.getTable → left.putTable = right.putTable → LgpLensConv left right
  | symm {left right : LgpLens} : LgpLensConv left right → LgpLensConv right left
  | trans {left middle right : LgpLens} :
      LgpLensConv left middle → LgpLensConv middle right → LgpLensConv left right

/-- Reflexivity of the congruence. -/
theorem lgpLensConvRefl (lens : LgpLens) : LgpLensConv lens lens :=
  LgpLensConv.ofTableEq lens lens rfl rfl

/-- Soundness of the congruence: convertible lenses have structurally-equal normal-form tables. -/
theorem lgpLensConvSound : {left right : LgpLens} → LgpLensConv left right →
    left.getTable = right.getTable ∧ left.putTable = right.putTable
  | _, _, .ofTableEq _ _ hGet hPut => ⟨hGet, hPut⟩
  | _, _, .symm hConv =>
      let ih := lgpLensConvSound hConv
      ⟨ih.left.symm, ih.right.symm⟩
  | _, _, .trans hLeft hRight =>
      let ihLeft := lgpLensConvSound hLeft
      let ihRight := lgpLensConvSound hRight
      ⟨ihLeft.left.trans ihRight.left, ihLeft.right.trans ihRight.right⟩

/-- Soundness of the word decision: convertible lenses decide `true`. -/
theorem lgpLensConvDecides {left right : LgpLens} (hConv : LgpLensConv left right) :
    lgpDecideLensConv left right = true := by
  have hSound := lgpLensConvSound hConv
  show (cswListNatBeq left.getTable right.getTable && cswListNatBeq left.putTable right.putTable) = true
  rw [hSound.left, hSound.right, cswListNatBeqRefl right.getTable, cswListNatBeqRefl right.putTable]
  rfl

/-- Completeness of the word decision: lenses that decide `true` are convertible. -/
theorem lgpDecideLensConvComplete (left right : LgpLens)
    (hDecide : lgpDecideLensConv left right = true) : LgpLensConv left right :=
  let hSplit := cswBoolAndElim _ _ hDecide
  LgpLensConv.ofTableEq left right
    (cswListNatBeqEq _ _ hSplit.left)
    (cswListNatBeqEq _ _ hSplit.right)

/-- Refutation half: lenses that decide `false` are not convertible. -/
theorem lgpLensConvRefute (left right : LgpLens)
    (hFalse : lgpDecideLensConv left right = false) : ¬ LgpLensConv left right :=
  fun hConv => Bool.noConfusion (Eq.trans hFalse.symm (lgpLensConvDecides hConv))

/-! ## T4 — the walls

Two deep extensions and one borderline census target, all `false` markers per the
`def <prefix>Has<Thing> : Bool := false` convention. -/

/-- WALL — general profunctor / coend optics (Prisms, Traversals, monadic/mixed optics, the
`forall p. p a b -> p s t` profunctor encoding).  These are NOT finite lookup-table optics:
the profunctor encoding quantifies over ALL profunctors and the Traversal/mixed cases carry
a coend (an existential quotient) with no finite normal form the `List Nat`-table carrier can
express.  Two burned attacks: (1) encode a Prism `S <-> A + C` as a partial `getTable` with a
sentinel "miss" value — fails PutGet's totality (the review/inject roundtrip needs the missing
`C` complement stored, which a single `List Nat` cannot recover deterministically); (2) encode
a Traversal as a `List (List Nat)` of focus positions — the coend identifies traversals up to
reordering of foci, an equivalence with no decidable finite-table representative here (would
need a quotient, hence `Quot.sound`).  Genuinely deep; walled. -/
def lgpHasGeneralOpticCompleteness : Bool := false

/-- WALL — the Poly double-category interchange: bifunctoriality of the tensor `<*>` on lenses
against composition `.` (the horizontal-vs-vertical interchange square in `Poly`).  Requires a
tensor product on lenses AND its interchange coherence with `lgpLensCompose` — the r30-style
interchange obstruction.  Two burned attacks: (1) define `tensor l m` on tables by the
Kronecker/product flatten `(s1,s2) -> (a1,a2)` and try `(l1 <*> m1) . (l2 <*> m2) =
(l1 . l2) <*> (m1 . m2)` by table `rfl` — the two sides flatten the product index in different
orders (`sourceSize`-major vs component-major), so the `putTable`s are permutations of each
other, NOT structurally equal, and no propext-free reindexing lemma equates them without a
`List` permutation quotient; (2) restrict to square factors to dodge the reindex — the
interchange still fails on the put chain rule because `put_outer (get_inner .)` does not
distribute over the tensor split (the get of one component leaks into the put of the other).
Walled. -/
def lgpHasPolyDoubleCoherence : Bool := false

/-- BORDERLINE (owner-false census target, NOT a hard wall) — lawful-lens completeness: every
lawful `(get, put)` pair over finite sets is realised by a canonical constant-complement lens
expression `S ~= A * C`.  Soundness (`lgpLensConvSound`) gives one half; the canonical-NF
direction needs a finite decomposition census (compute the fibres of `get`, prove they all
have equal cardinality `= |C|`, and that `put` is exactly second-projection under `S ~= A * C`).
Flagged `false` initially; this is the completeness leg to attempt next, distinct from the two
deep extensions above which stay walled. -/
def lgpHasLawfulLensCompleteness : Bool := false

/-! ## T5 — ground fires (all `rfl`, small sizes) -/

/-- The identity lens on `[2]` is GetPut-lawful. -/
theorem lgpFireIdentityGetPut : lgpIsGetPutLawful (lgpIdentityLens 2) = true := rfl

/-- The identity lens on `[2]` is PutGet-lawful. -/
theorem lgpFireIdentityPutGet : lgpIsPutGetLawful (lgpIdentityLens 2) = true := rfl

/-- The identity lens on `[2]` is PutPut-lawful. -/
theorem lgpFireIdentityPutPut : lgpIsPutPutLawful (lgpIdentityLens 2) = true := rfl

/-- The identity lens on `[3]` is GetPut-lawful (a second size). -/
theorem lgpFireIdentityGetPutThree : lgpIsGetPutLawful (lgpIdentityLens 3) = true := rfl

/-- The identity lens on `[2]` is well-formed. -/
theorem lgpFireIdentityWellFormed : lgpIsWellFormed (lgpIdentityLens 2) = true := rfl

/-- A concrete **non-lens** `[2] <-> [2]`: `get s = 1 - s` (table `[1,0]`) with a constant
`put s a = 0` (table `[0,0,0,0]`).  It VIOLATES PutGet: `get (put s 1) = get 0 = 1`... actually
`get 0 = getTable[0] = 1`, so `get (put s 1) = 1 = a` there, but `get (put s 0) = get 0 = 1 != 0`.
The decision correctly returns `false`. -/
def lgpBadLens : LgpLens where
  sourceSize := 2
  aSize := 2
  getTable := [1, 0]
  putTable := [0, 0, 0, 0]

/-- The non-lens is refuted by the PutGet decision. -/
theorem lgpFireBadPutGet : lgpIsPutGetLawful lgpBadLens = false := rfl

/-- A concrete well-formed lens `[2] <-> [2]`: `get s = 1 - s` (table `[1,0]`), `put s a = a`
(table `[0,1,0,1]`). -/
def lgpSwapLens : LgpLens where
  sourceSize := 2
  aSize := 2
  getTable := [1, 0]
  putTable := [0, 1, 0, 1]

/-- **Convertibility fire**: `id . swap` decides equal to `swap` (right-identity of composition,
by table `rfl`). -/
theorem lgpFireComposeIdentityDecides :
    lgpDecideLensConv (lgpLensCompose lgpSwapLens (lgpIdentityLens 2)) lgpSwapLens = true := rfl

/-- The same identity law lifted into the congruence (the tables are definitionally equal). -/
theorem lgpFireComposeIdentityConv :
    LgpLensConv (lgpLensCompose lgpSwapLens (lgpIdentityLens 2)) lgpSwapLens :=
  LgpLensConv.ofTableEq _ _ rfl rfl

/-- **Control fire**: two genuinely different lenses (`swap` vs `identity`) decide NOT equal. -/
theorem lgpFireDistinctDecides :
    lgpDecideLensConv lgpSwapLens (lgpIdentityLens 2) = false := rfl

/-- ... and are therefore not convertible (refutation half in action). -/
theorem lgpFireDistinctNotConv :
    ¬ LgpLensConv lgpSwapLens (lgpIdentityLens 2) :=
  lgpLensConvRefute _ _ rfl

end FX1Poly.Polygraph.Optic

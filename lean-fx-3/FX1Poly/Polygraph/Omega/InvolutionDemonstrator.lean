namespace FX1Poly.Polygraph.Omega

/-! ## The walking-involution 2-polygraph as an OmegaComputad -/

/-- The **walking-involution omega-computad**: one object, one generator label at every dimension (`Unit`).
The presentation only USES the dim-1 generator (`s`) and the dim-2 generator (`rho`); no free 3-generator is
constructed, so the only dim-3 content is the critical-pair filler. -/
def involutionOmegaComputad : OmegaComputad where
  modeCarrier := Unit
  genLabel := fun _ => Unit

/-- The trivial mode comparator (one object). -/
def involutionModeBeq : involutionOmegaComputad.modeCarrier → involutionOmegaComputad.modeCarrier → Bool :=
  fun _ _ => true

/-- The trivial heterogeneous generator comparator (one label per dimension). -/
def involutionGenBeq :
    (dimA dimB : Nat) → involutionOmegaComputad.genLabel dimA → involutionOmegaComputad.genLabel dimB → Bool :=
  fun _ _ _ _ => true

/-- The single object `*`. -/
def involutionPoint : CellExpr involutionOmegaComputad 0 := CellExpr.ofMode ()

/-- The endo-1-generator `s : * => *`. -/
def involutionSGen : CellExpr involutionOmegaComputad 1 :=
  CellExpr.gen (dim := 0) () involutionPoint involutionPoint

/-- The 1-cell `ss` (the rule's left-hand side). -/
def involutionSsWord : CellExpr involutionOmegaComputad 1 :=
  CellExpr.vcomp involutionSGen involutionSGen

/-- The identity 1-cell `id` (the rule's right-hand side, `s^0`). -/
def involutionIdOne : CellExpr involutionOmegaComputad 1 := CellExpr.id involutionPoint

/-- ★ The **rewrite rule** `rho : ss => id` as the single 2-cell generator.  Globular: `ss` and `id` are both
`* => *`. -/
def involutionRhoGen : CellExpr involutionOmegaComputad 2 :=
  CellExpr.gen (dim := 1) () involutionSsWord involutionIdOne

/-! ## The two legs of the sole critical pair `sss` -/

/-- The **left leg**: reduce the FRONT `ss` of `sss` — `rho` whiskered on the right by `s`
(`(ss)s => (id)s`). -/
def involutionLeftLeg : CellExpr involutionOmegaComputad 2 :=
  CellExpr.whiskerRight involutionRhoGen involutionSGen

/-- The **right leg**: reduce the BACK `ss` of `sss` — `rho` whiskered on the left by `s`
(`s(ss) => s(id)`). -/
def involutionRightLeg : CellExpr involutionOmegaComputad 2 :=
  CellExpr.whiskerLeft involutionSGen involutionRhoGen

/-- The left leg's source 1-cell is the front-associated peak `(ss)s`. -/
theorem involutionLeftLeg_boundarySource :
    boundarySource involutionLeftLeg = CellExpr.vcomp involutionSsWord involutionSGen := rfl

/-- The left leg's target 1-cell is `(id)s`. -/
theorem involutionLeftLeg_boundaryTarget :
    boundaryTarget involutionLeftLeg = CellExpr.vcomp involutionIdOne involutionSGen := rfl

/-- The right leg's source 1-cell is the back-associated peak `s(ss)`. -/
theorem involutionRightLeg_boundarySource :
    boundarySource involutionRightLeg = CellExpr.vcomp involutionSGen involutionSsWord := rfl

/-- The right leg's target 1-cell is `s(id)`. -/
theorem involutionRightLeg_boundaryTarget :
    boundaryTarget involutionRightLeg = CellExpr.vcomp involutionSGen involutionIdOne := rfl

/-! ## The critical-pair row and the generating 3-cell -/

/-- ★ The **`sss` critical-pair row** — a `CellRelOver` firing on the two reduction legs.  This is the
walking involution's homotopy basis: ONE generating 3-cell. -/
inductive InvolutionCriticalRow :
    {d : Nat} → CellExpr involutionOmegaComputad d → CellExpr involutionOmegaComputad d → Prop where
  /-- The `sss` critical pair: the front-redex leg and the back-redex leg. -/
  | sss : InvolutionCriticalRow involutionLeftLeg involutionRightLeg

/-- The base relation the 3-cells resolve: the strict omega laws united with the single critical-pair row. -/
def involutionBaseRel : CellRelOver involutionOmegaComputad :=
  unionCellRel involutionOmegaComputad (StrictAxiomRel involutionOmegaComputad) InvolutionCriticalRow

/-- ★ **THE GENERATING 3-CELL.**  The `sss` critical pair fired through `ofRelation`: a genuine
`SaturatedConvOverWithId` convertibility between the two parallel-modulo-strict legs.  Non-vacuous — the two
legs are structurally distinct 2-cells. -/
def involutionSssThreeCell :
    SaturatedConvOverWithId involutionOmegaComputad involutionBaseRel
      involutionLeftLeg involutionRightLeg :=
  SaturatedConvOverWithId.ofRelation (Or.inr InvolutionCriticalRow.sss)

/-- The two legs are structurally DISTINCT (whisker-right vs whisker-left): the 3-cell genuinely fills a
non-trivial branching. -/
theorem involutionLegs_distinct :
    cellBeq involutionModeBeq involutionGenBeq involutionLeftLeg involutionRightLeg = false := rfl

/-! ## The joinability witnesses (the critical pair is resolved modulo the strict congruence) -/

/-- The left-unit join `(id)s ~ s`. -/
def involutionLeftUnitJoin :
    SaturatedConvOverWithId involutionOmegaComputad involutionBaseRel
      (CellExpr.vcomp involutionIdOne involutionSGen) involutionSGen :=
  SaturatedConvOverWithId.ofRelation (Or.inl (StrictAxiomRel.vcompUnitLeft involutionSGen))

/-- The right-unit join `s(id) ~ s`. -/
def involutionRightUnitJoin :
    SaturatedConvOverWithId involutionOmegaComputad involutionBaseRel
      (CellExpr.vcomp involutionSGen involutionIdOne) involutionSGen :=
  SaturatedConvOverWithId.ofRelation (Or.inl (StrictAxiomRel.vcompUnitRight involutionSGen))

/-- ★ **THE PEAK JOIN** — the two leg SOURCES join by associativity: `(ss)s ~ s(ss)`.  The two peak
spellings are convertible in the strict congruence (though structurally distinct). -/
def involutionPeakJoin :
    SaturatedConvOverWithId involutionOmegaComputad involutionBaseRel
      (boundarySource involutionLeftLeg) (boundarySource involutionRightLeg) :=
  SaturatedConvOverWithId.ofRelation
    (Or.inl (StrictAxiomRel.vcompAssoc involutionSGen involutionSGen involutionSGen))

/-- ★ **THE VALLEY JOIN** — the two leg TARGETS join through the common valley `s`: `(id)s ~ s ~ s(id)`, so
the critical pair reaches a distinguished valley modulo the strict units. -/
def involutionValleyJoin :
    SaturatedConvOverWithId involutionOmegaComputad involutionBaseRel
      (boundaryTarget involutionLeftLeg) (boundaryTarget involutionRightLeg) :=
  SaturatedConvOverWithId.trans involutionLeftUnitJoin
    (SaturatedConvOverWithId.symm involutionRightUnitJoin)

/-! ## The out-of-scope example, named honestly (literal globularity fails) -/

/-- ★ **THE OUT-OF-SCOPE EXAMPLE.**  Literal globularity FAILS: the two leg source 1-cells `(ss)s` and
`s(ss)` are structurally DISTINCT, so the legs are NOT an `IsParallelPair` in the free carrier — the critical
pair inherently spans two associations.  Parallelism holds only MODULO the strict congruence (witnessed by
`involutionPeakJoin` / `involutionValleyJoin`).  This is the honest fragment boundary: the free-carrier
critical pair is joinable-modulo-strict, not literally globular. -/
theorem involutionLegs_notLiterallyParallel :
    cellBeq involutionModeBeq involutionGenBeq
      (boundarySource involutionLeftLeg) (boundarySource involutionRightLeg) = false := rfl

/-! ## The honesty marker -/

/-- **ESTABLISHED (fragment scope).**  The walking involution `<s | s.s => id>` re-encoded as an
`OmegaComputad` 2-polygraph has its SOLE critical pair `sss` exhibited as a dim-3 content: the two reduction

import FX1Poly.Polygraph.TwoCategory.Brauer.WiringDescInsertion

/-! # WP-BRAUER-4 r6 — the COMB FOLD: the Coxeter–Moser coset factorization of a crossing word

The r5 insertion route (`Brauer/WiringDescInsertion.lean`) reduced the crossing-only word problem to ONE residual —
the general braid-move INSERTION induction — which jammed on the standing stuck word
`[crossingAt 2, crossingAt 0, crossingAt 1, crossingAt 2]` (the `BraidAscentInsertionStep` residual at permutation
`[1, 3, 0, 2]`).  This file lands the ALTERNATE route the recon confirmed dissolves that jam: the classical
Coxeter–Moser / Björner–Brenti right-coset comb.

## The factorization

`S_{n+1}` (generators `s_0, …, s_{n-1}`) factors as `S_n · C` where `S_n` is the parabolic subgroup generated by
`s_0, …, s_{n-2}` (indices `< n-1`) and `C = { e, s_{n-1}, s_{n-1}s_{n-2}, …, s_{n-1}…s_0 }` are the minimal-length
coset representatives — the descending runs anchored at the top generator `s_{n-1}` (Björner–Brenti,
*Combinatorics of Coxeter Groups*, Prop. 2.4.4; the right-descent transversal `D_R(u) ∩ {s_0..s_{n-2}} = ∅` is
exactly the `mentionsOnlyBelow (n-1)` certificate).  Every crossing word is thus `BrauerConvFree7`-convertible to
`u ++ run` where `u` mentions only indices `< n-1` and `run` is a descending run.

## Orientation (pinned by the recon's hand computation)

Words act LEFT-TO-RIGHT — `permuteOfCrossingWord` is a head-first `foldl`, so the comb fold consumes the input word
HEAD-FIRST and appends each new letter on the RIGHT of the carrier `u ++ run`.  The run is DESCENDING as written
(`descendingPositions (n-1) count = [s_{n-1}, s_{n-2}, …]`), anchored at the top generator `s_{n-1}`; `n` is the
number of generators.

## The comb CARRY (C4) — the crux

Appending `s_i` on the right of a descending run `[s_{n-1}, …, s_k]` with `k < i ≤ n-1` emits `s_{i-1}` on the left
(into `u`) and restores the run.  The move is: distant-commute `s_i` past the lower sub-run `[s_{i-2}, …, s_k]`
(indices `≤ i-2`), a single R3 braid at the located `s_i s_{i-1} s_i`, then distant-commute `s_{i-1}` past the upper
sub-run `[s_{n-1}, …, s_{i+1}]` (indices `≥ i+1`).  All three moves are the FREE Coxeter moves
(`crossingCommuteFree` / `crossingBraidFree`, `Brauer/WiringDescStraightening.lean`), so the whole carry lives in the
over-approximation `BrauerConvFree7` and never touches the pad keystone.

Raw Lean 4 + Init; structural recursion, no `omega` / `simp`-AC / `native_decide` / `WellFounded.fix`.
Per-declaration `#assert_no_axioms` in the audit twin. -/

set_option autoImplicit false

namespace FX1Poly.Polygraph

/-! ## Local propext-free structural helpers

`List.append_assoc` / `List.append_nil` leak `propext` (`reverseConsLocal` / `appendSnocAssoc` in
`Brauer/WiringDescInsertion.lean` re-derive them structurally); we re-declare the one associativity form the comb
fold needs, file-locally. -/

/-- `(front ++ mid) ++ back = front ++ (mid ++ back)` — structural on `front`, so it avoids the `propext`-tainted
`List.append_assoc`.  Subsumes the snoc form (`appendSnocAssocComb front [mid] back` reduces to
`front ++ (mid :: back)`). -/
private theorem appendAssocComb :
    (front mid back : List BrauerAtom) → (front ++ mid) ++ back = front ++ (mid ++ back)
  | [], _, _ => rfl
  | head :: rest, mid, back => congrArg (head :: ·) (appendAssocComb rest mid back)

/-- `i - 1 + 1 = i` when `1 ≤ i` — structural on `i` (the positivity rules out `0`), `propext`-free. -/
private theorem predSuccOfPos : (i : Nat) → 1 ≤ i → i - 1 + 1 = i
  | 0, positive => absurd positive (by decide)
  | _ + 1, _ => rfl

/-! ## B1 — the run datatype + the invariant predicates -/

/-- ★ **A descending run of positions** — `descendingPositions top count = [top, top-1, …, top-count+1]`, the
`count` topmost generator indices below-or-at `top`.  Structural on `count`, so it computes; the run of the
Coxeter–Moser coset is `descendingPositions (n-1) count` (anchored at the top generator `s_{n-1}`). -/
def descendingPositions (top : Nat) : Nat → List Nat
  | 0 => []
  | count + 1 => top :: descendingPositions (top - 1) count

/-- ★ **The `mentionsOnlyBelow` certificate** — every position of the word is strictly below `bound`.  A full-enum
`Bool` all-scan (`Nat.blt`), propext-free, matching the house style of `isAscendingFrom` / `isIdentityPerm`.  For the
comb the `u`-fragment carries `mentionsOnlyBelow (n-1) u = true` — the Björner–Brenti right-descent transversal
condition. -/
def mentionsOnlyBelow (bound : Nat) : List Nat → Bool
  | [] => true
  | position :: rest => Nat.blt position bound && mentionsOnlyBelow bound rest

/-- ★ **`AllDistantFrom letterIndex block`** — every position in `block` is at distance `≥ 2` from `letterIndex`
(strictly above `letterIndex + 1` or strictly below `letterIndex - 1`), so the corresponding crossing generator
commutes freely past `s_letterIndex`.  An inductive over the block, matched structurally by the `commuteBlock`
fold. -/
inductive AllDistantFrom (letterIndex : Nat) : List Nat → Prop
  /-- The empty block is trivially all-distant. -/
  | nil : AllDistantFrom letterIndex []
  /-- A head position distant from the letter, over an all-distant tail. -/
  | cons (position : Nat) (rest : List Nat) :
      (position + 2 ≤ letterIndex ∨ letterIndex + 2 ≤ position) →
      AllDistantFrom letterIndex rest →
      AllDistantFrom letterIndex (position :: rest)

/-! ## B2 — the commuteBlock helper (a single letter past a distant block) -/

/-- One distant adjacent pair commutes: `[s_position, s_letterIndex] ~ [s_letterIndex, s_position]`.  Dispatches the
distance disjunction to `crossingCommuteFree` (left disjunct, direct) or its `symm` (right disjunct). -/
private theorem commuteAdjacentPair (position letterIndex : Nat)
    (distant : position + 2 ≤ letterIndex ∨ letterIndex + 2 ≤ position) :
    BrauerConvFree7 [crossingAt position, crossingAt letterIndex]
      [crossingAt letterIndex, crossingAt position] :=
  match distant with
  | Or.inl belowLe => crossingCommuteFree position letterIndex belowLe
  | Or.inr aboveLe => BrauerConvFree7.symm (crossingCommuteFree letterIndex position aboveLe)

/-- ★ **`commuteLetterPastBlock` — move one crossing leftward past a whole distant block.**  Given
`AllDistantFrom letterIndex block`, the letter `s_letterIndex` appended on the right of `crossingWord block` commutes
all the way to the front: `crossingWord block ++ [crossingAt letterIndex] ~ crossingAt letterIndex :: crossingWord
block`.  A structural fold over the `AllDistantFrom` derivation, each step one `commuteAdjacentPair`.  The two carry
sub-moves and the COMMUTE case are its instances. -/
theorem commuteLetterPastBlock (letterIndex : Nat) :
    (block : List Nat) → AllDistantFrom letterIndex block →
    BrauerConvFree7 (crossingWord block ++ [crossingAt letterIndex])
      (crossingAt letterIndex :: crossingWord block)
  | _, .nil => BrauerConvFree7.ofFree (BrauerConvFree.refl [crossingAt letterIndex])
  | _, .cons position rest headDistant restDistant =>
      BrauerConvFree7.trans
        (BrauerConvFree7.whiskerLeft [crossingAt position]
          (commuteLetterPastBlock letterIndex rest restDistant))
        (BrauerConvFree7.whiskerRight (crossingWord rest)
          (commuteAdjacentPair position letterIndex headDistant))

/-! ## B2 — the C4 CARRY crux (parametric two-block form) -/

/-- ★★ **C4 — the comb CARRY.**  A descending run split as `upperBlock ++ [s_i, s_{i-1}] ++ lowerBlock`
(`upperBlock` all distant-above `s_{i-1}`, `lowerBlock` all distant-below `s_i`), receiving `s_i` on the right,
emits `s_{i-1}` on the left and restores the run.  Built from `commuteLetterPastBlock` (lower), one `crossingBraidFree`
at the located triple, and `commuteLetterPastBlock` (upper), all in `BrauerConvFree7` — the exact three-move carry the
recon's simulation tables A/B/C validated.  Lifts under an arbitrary comb prefix `u` for FREE via
`BrauerConvFree7.whiskerLeft`. -/
theorem combCase_carry (upperBlock lowerBlock : List Nat) (i : Nat) (hi : 1 ≤ i)
    (upperDistant : AllDistantFrom (i - 1) upperBlock)
    (lowerDistant : AllDistantFrom i lowerBlock) :
    BrauerConvFree7
      ((crossingWord upperBlock ++ (crossingAt i :: crossingAt (i - 1) :: crossingWord lowerBlock))
        ++ [crossingAt i])
      (crossingAt (i - 1)
        :: (crossingWord upperBlock ++ (crossingAt i :: crossingAt (i - 1) :: crossingWord lowerBlock))) := by
  -- Step 1: commute the appended `s_i` leftward past the lower block.
  have step1 : BrauerConvFree7
      (crossingWord upperBlock
        ++ (crossingAt i :: crossingAt (i - 1) :: (crossingWord lowerBlock ++ [crossingAt i])))
      (crossingWord upperBlock
        ++ (crossingAt i :: crossingAt (i - 1) :: (crossingAt i :: crossingWord lowerBlock))) :=
    BrauerConvFree7.whiskerLeft (crossingWord upperBlock)
      (BrauerConvFree7.whiskerLeft [crossingAt i, crossingAt (i - 1)]
        (commuteLetterPastBlock i lowerBlock lowerDistant))
  -- Step 2: braid the located triple `s_i s_{i-1} s_i` to `s_{i-1} s_i s_{i-1}`.
  have braidRaw := crossingBraidFree (i - 1)
  rw [predSuccOfPos i hi] at braidRaw
  have step2 : BrauerConvFree7
      (crossingWord upperBlock
        ++ (crossingAt i :: crossingAt (i - 1) :: crossingAt i :: crossingWord lowerBlock))
      (crossingWord upperBlock
        ++ (crossingAt (i - 1) :: crossingAt i :: crossingAt (i - 1) :: crossingWord lowerBlock)) :=
    BrauerConvFree7.whiskerLeft (crossingWord upperBlock)
      (BrauerConvFree7.whiskerRight (crossingWord lowerBlock) (BrauerConvFree7.symm braidRaw))
  -- Step 3: commute the emitted `s_{i-1}` leftward past the upper block into `u`.
  have step3 : BrauerConvFree7
      (crossingWord upperBlock
        ++ (crossingAt (i - 1) :: (crossingAt i :: crossingAt (i - 1) :: crossingWord lowerBlock)))
      (crossingAt (i - 1)
        :: (crossingWord upperBlock ++ (crossingAt i :: crossingAt (i - 1) :: crossingWord lowerBlock))) := by
    have base := BrauerConvFree7.whiskerRight
      (crossingAt i :: crossingAt (i - 1) :: crossingWord lowerBlock)
      (commuteLetterPastBlock (i - 1) upperBlock upperDistant)
    rw [appendAssocComb (crossingWord upperBlock) [crossingAt (i - 1)]
      (crossingAt i :: crossingAt (i - 1) :: crossingWord lowerBlock)] at base
    exact base
  rw [appendAssocComb (crossingWord upperBlock)
    (crossingAt i :: crossingAt (i - 1) :: crossingWord lowerBlock) [crossingAt i]]
  exact step1.trans (step2.trans step3)

end FX1Poly.Polygraph

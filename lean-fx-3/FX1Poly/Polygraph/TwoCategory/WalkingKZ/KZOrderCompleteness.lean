/-! ## KZ boundary-cast congruence + fold-invisibility of casts -/

/-- The KZ 2-cell order transports along a boundary cast on BOTH sides — `KZTwoCellLE a b` gives
`KZTwoCellLE (cast a) (cast b)`.  The order analog of `MonadSaturatedTwoCellConv.castBoundaryCongr`; the cast is
a double `Eq.rec`, so `cases` on the two boundary equalities collapses it to the identity. -/
theorem KZTwoCellLE.castBoundaryCongr
    {sourcePath sourcePath' targetPath targetPath' : ModalityPath monadGraph MonadMode.point MonadMode.point}
    (hsource : sourcePath = sourcePath') (htarget : targetPath = targetPath')
    {cellAlpha cellBeta : RawTwoCellExpr monadModeSignature sourcePath targetPath}
    (le : KZTwoCellLE cellAlpha cellBeta) :
    KZTwoCellLE (RawTwoCellExpr.castBoundary hsource htarget cellAlpha)
      (RawTwoCellExpr.castBoundary hsource htarget cellBeta) := by
  cases hsource; cases htarget; exact le

/-- **Casting a cell is fold-invisible**: `monadMonotoneMapOf (castBoundary hs ht cell) = monadMonotoneMapOf
cell`.  The Δ₊ fold reads only the spine (which the boundary paths do not enter), so `cases` on the two boundary
equalities collapses the cast.  The order-decision analog of `RawTwoCellExpr.castBoundary_spine`. -/
theorem monadMonotoneMapOf_castBoundary
    {sourcePath sourcePath' targetPath targetPath' : ModalityPath monadGraph MonadMode.point MonadMode.point}
    (hsource : sourcePath = sourcePath') (htarget : targetPath = targetPath')
    (cell : RawTwoCellExpr monadModeSignature sourcePath targetPath) :
    monadMonotoneMapOf (RawTwoCellExpr.castBoundary hsource htarget cell) = monadMonotoneMapOf cell := by
  cases hsource; cases htarget; rfl

/-! ## KZ horizontal-composite congruences (completing the KZ congruence closure for `hcomp`) -/

/-- Congruence in the RIGHT factor of a KZ horizontal composite: `hcomp α = whiskerRight … then whiskerLeft …`,
so replacing the right factor by a KZ-larger one enlarges the composite (`whiskerLeftCongr` under a `vcompCongr`).
The order analog of `MonadSaturatedTwoCellConv.hcompCongrRight`. -/
theorem KZTwoCellLE.hcompCongrRight {sourceMode middleMode targetMode : MonadMode}
    {oneCellFDom oneCellFCod : ModalityPath monadModeSignature.graph sourceMode middleMode}
    {oneCellGDom oneCellGCod : ModalityPath monadModeSignature.graph middleMode targetMode}
    (cellAlpha : RawTwoCellExpr monadModeSignature oneCellFDom oneCellFCod)
    {cellBeta cellBeta' : RawTwoCellExpr monadModeSignature oneCellGDom oneCellGCod}
    (le : KZTwoCellLE cellBeta cellBeta') :
    KZTwoCellLE (RawTwoCellExpr.hcomp cellAlpha cellBeta) (RawTwoCellExpr.hcomp cellAlpha cellBeta') :=
  KZTwoCellLE.vcompCongrRight _ (KZTwoCellLE.whiskerLeftCongr oneCellFCod le)

/-- Congruence in the LEFT factor of a KZ horizontal composite (the dual of `hcompCongrRight`, via
`whiskerRightCongr` under a `vcompCongr`). -/
theorem KZTwoCellLE.hcompCongrLeft {sourceMode middleMode targetMode : MonadMode}
    {oneCellFDom oneCellFCod : ModalityPath monadModeSignature.graph sourceMode middleMode}
    {oneCellGDom oneCellGCod : ModalityPath monadModeSignature.graph middleMode targetMode}
    {cellAlpha cellAlpha' : RawTwoCellExpr monadModeSignature oneCellFDom oneCellFCod}
    (cellBeta : RawTwoCellExpr monadModeSignature oneCellGDom oneCellGCod)
    (le : KZTwoCellLE cellAlpha cellAlpha') :
    KZTwoCellLE (RawTwoCellExpr.hcomp cellAlpha cellBeta) (RawTwoCellExpr.hcomp cellAlpha' cellBeta) :=
  KZTwoCellLE.vcompCongrLeft _ (KZTwoCellLE.whiskerRightCongr oneCellGDom le)

/-! ## The merge-collapse `List Nat` identities (the fold of the covering witness) -/

/-- `composeMap` over a `consReplicate` block: a run of `count` copies of `value` maps to a run of `count` copies
of `second`'s value at `value`.  Cons-only structural recursion on `count`. -/
theorem composeMap_consReplicate (value count : Nat) (tail second : List Nat) :
    composeMap (consReplicate value count tail) second
      = consReplicate (monotoneMapGet second value) count (composeMap tail second) := by
  induction count with
  | zero => rfl
  | succ n ih =>
      show monotoneMapGet second value :: composeMap (consReplicate value n tail) second
        = monotoneMapGet second value
          :: consReplicate (monotoneMapGet second value) n (composeMap tail second)
      rw [ih]

/-- Two adjacent `consReplicate` runs of the SAME value fuse: `consReplicate v a (consReplicate v c tail) =
consReplicate v (a+c) tail`.  Cons-only structural recursion on `a`. -/
theorem consReplicate_add (value countA countC : Nat) (tail : List Nat) :
    consReplicate value countA (consReplicate value countC tail) = consReplicate value (countA + countC) tail := by
  induction countA with
  | zero =>
      show consReplicate value countC tail = consReplicate value (0 + countC) tail
      rw [Nat.zero_add]
  | succ n ih =>
      show value :: consReplicate value n (consReplicate value countC tail)
        = consReplicate value (Nat.succ n + countC) tail
      rw [Nat.succ_add]
      show value :: consReplicate value n (consReplicate value countC tail)
        = value :: consReplicate value (n + countC) tail
      rw [ih]

/-- ★ **The SOURCE merge collapse.**  Post-composing the unmerged 4-block reconstruction `reconstructFrom 0
[a,1,0,b]` (`= [0×a, 1, 3×b]`) with the fixed merge map `reconstructFrom 0 [2,2]` (`= [0,0,1,1]`, i.e. fuse
targets `{0,1}` and `{2,3}`) collapses to the MERGED 2-block reconstruction `reconstructFrom 0 [a+1,b]` (`=
[0×(a+1), 1×b]`).  This is the covering witness's source fold: the moving strand (target `1`) and the `a`-merge
(target `0`) fuse to target `0`.  Cons-only `composeMap`/`consReplicate` algebra. -/
theorem mergeCollapse_srcCounts (widthLeft widthRight : Nat) :
    composeMap (reconstructFrom 0 [widthLeft, 1, 0, widthRight]) (reconstructFrom 0 [2, 2])
      = reconstructFrom 0 [widthLeft + 1, widthRight] := by
  show composeMap (consReplicate 0 widthLeft (1 :: consReplicate 3 widthRight [])) [0, 0, 1, 1]
    = reconstructFrom 0 [widthLeft + 1, widthRight]
  rw [composeMap_consReplicate]
  show consReplicate 0 widthLeft (0 :: composeMap (consReplicate 3 widthRight []) [0, 0, 1, 1])
    = reconstructFrom 0 [widthLeft + 1, widthRight]
  rw [composeMap_consReplicate]
  show consReplicate 0 widthLeft (consReplicate 0 1 (consReplicate 1 widthRight []))
    = reconstructFrom 0 [widthLeft + 1, widthRight]
  rw [consReplicate_add]
  rfl

/-- ★ **The TARGET merge collapse.**  Post-composing the moved unmerged reconstruction `reconstructFrom 0
[a,0,1,b]` (`= [0×a, 2, 3×b]`) with the same merge `[0,0,1,1]` collapses to `reconstructFrom 0 [a,b+1]` (`=
[0×a, 1×(b+1)]`): the moving strand (now target `2`) and the `b`-merge (target `3`) fuse to target `1`.  Cons-only
algebra (the dual of `mergeCollapse_srcCounts`). -/
theorem mergeCollapse_tgtCounts (widthLeft widthRight : Nat) :
    composeMap (reconstructFrom 0 [widthLeft, 0, 1, widthRight]) (reconstructFrom 0 [2, 2])
      = reconstructFrom 0 [widthLeft, widthRight + 1] := by
  show composeMap (consReplicate 0 widthLeft (consReplicate 2 1 (consReplicate 3 widthRight []))) [0, 0, 1, 1]
    = reconstructFrom 0 [widthLeft, widthRight + 1]
  rw [composeMap_consReplicate, composeMap_consReplicate, composeMap_consReplicate]
  show consReplicate 0 widthLeft (consReplicate 1 1 (consReplicate 1 widthRight []))
    = reconstructFrom 0 [widthLeft, widthRight + 1]
  rw [consReplicate_add, Nat.add_comm 1 widthRight]
  rfl

/-! ## The atomic covering move — one whiskered `kzGen` in merge context -/

/-- ★ **The BASE covering** `word [1,0] ⇒ word [0,1]` — the bare `kzGen`, no context.  `word [1,0]` folds `[0]`
(one strand at target `0`, an `eta`-inserted target `1`) and is PARALLEL to `kzTEtaCell` (both `t ⇒ t·t`);
`word [0,1]` folds `[1]` and is parallel to `kzEtaTCell`.  So the base covering is `kzGen` bridged by two EQUALITY
convertibilities (`kzLE_ofMapEq`, fold `[0] = [0]` and `[1] = [1]`) — cast-free, the single `kzGen` order step. -/
theorem kzBaseCovering : KZTwoCellLE (wordFromCounts [1, 0]) (wordFromCounts [0, 1]) :=
  KZTwoCellLE.trans
    (kzLE_ofMapEq (show monadMonotoneMapOf (wordFromCounts [1, 0]) = monadMonotoneMapOf kzTEtaCell by
      rw [monadMonotoneMapOf_wordFromCounts]; rfl))
    (KZTwoCellLE.trans KZTwoCellLE.kzGen
      (kzLE_ofMapEq (show monadMonotoneMapOf kzEtaTCell = monadMonotoneMapOf (wordFromCounts [0, 1]) by
        rw [monadMonotoneMapOf_wordFromCounts]; rfl)))

/-- The base covering under a RIGHT context `t^b`-merge: `word [1,0,b] ⇒ word [0,1,b]`.  Split the merge tail off
by `wordMul_hcomp` (`word [1,0,b] ≈ cast (word [1,0] ⊠ word [b])`), fire `kzBaseCovering` on the `[1,0]` factor
through `hcompCongrLeft`, and reassemble (`wordMul_hcomp` symmetrised).  The `wordMul` equalities lift to the KZ
order by `KZTwoCellLE.ofMonad`; the boundary casts thread through `castBoundaryCongr`. -/
theorem kzCoveringRightContext (widthRight : Nat) :
    KZTwoCellLE (wordFromCounts (consAppend [1, 0] [widthRight]))
      (wordFromCounts (consAppend [0, 1] [widthRight])) := by
  refine KZTwoCellLE.trans (KZTwoCellLE.ofMonad (wordMul_hcomp [1, 0] [widthRight])) ?_
  refine KZTwoCellLE.trans (KZTwoCellLE.castBoundaryCongr _ _
    (KZTwoCellLE.hcompCongrLeft (wordFromCounts [widthRight]) kzBaseCovering)) ?_
  exact KZTwoCellLE.ofMonad (MonadSaturatedTwoCellConv.symm (wordMul_hcomp [0, 1] [widthRight]))

/-- ★★ **The ATOMIC covering move** `word [a,1,0,b] ⇒ word [a,0,1,b]`: one strand moves one fibre rightward past
the `eta`-inserted target, with the `a`-merge on the LEFT and the `b`-merge on the RIGHT carried as horizontal
context.  Split the left `a`-merge off (`wordMul_hcomp [a] …`), fire `kzCoveringRightContext` on the `[1,0,b]`
factor through `hcompCongrRight`, and reassemble.  This is the recon's covering move — ONE whiskered `kzGen`
(inside `kzCoveringRightContext` / `kzBaseCovering`) composed with `wordMul_hcomp` monad-conv reshuffling — the
sole GENUINE order content of the completeness leg, mechanized zero-axiom. -/
theorem kzAtomicCovering (widthLeft widthRight : Nat) :
    KZTwoCellLE (wordFromCounts (consAppend [widthLeft] (consAppend [1, 0] [widthRight])))
      (wordFromCounts (consAppend [widthLeft] (consAppend [0, 1] [widthRight]))) := by
  refine KZTwoCellLE.trans (KZTwoCellLE.ofMonad (wordMul_hcomp [widthLeft] (consAppend [1, 0] [widthRight]))) ?_
  refine KZTwoCellLE.trans (KZTwoCellLE.castBoundaryCongr _ _
    (KZTwoCellLE.hcompCongrRight (wordFromCounts [widthLeft]) (kzCoveringRightContext widthRight))) ?_
  exact KZTwoCellLE.ofMonad
    (MonadSaturatedTwoCellConv.symm (wordMul_hcomp [widthLeft] (consAppend [0, 1] [widthRight])))

/-- The atomic covering restated on the literal 4-count lists (`consAppend [a] (consAppend [1,0] [b]) = [a,1,0,b]`
definitionally). -/
theorem kzAtomicCoveringLiteral (widthLeft widthRight : Nat) :
    KZTwoCellLE (wordFromCounts [widthLeft, 1, 0, widthRight]) (wordFromCounts [widthLeft, 0, 1, widthRight]) :=
  kzAtomicCovering widthLeft widthRight

/-! ## The flat covering carrier: canonical words cast to `t^(listSum) ⇒ t^length` -/

/-- ★ The **flat Eilenberg–Zilber word** of a count vector `cs` at the FLAT boundary `t^(listSum cs) ⇒ t^m`
(here `n = listSum cs`, `m = cs.length`): `wordFromCounts cs` transported from its native domain
`countsDomainPath cs` onto the flat `t`-power `monadTPower n` (they are equal by
`countsDomainPath_eq_monadTPower_listSum`) and its codomain onto `monadTPower m`.  Casting to the flat boundary is
what makes ALL words of a fixed `(n,m)` mutually PARALLEL, so covering-chain waypoints bridge cast-free by fold
equality (`kzLE_ofMapEq`). -/
def kzFlatWord (widthTotal widthCod : Nat) (counts : List Nat)
    (hsum : listSum counts = widthTotal) (hlen : counts.length = widthCod) :
    RawTwoCellExpr monadModeSignature (monadTPower widthTotal) (monadTPower widthCod) :=
  RawTwoCellExpr.castBoundary
    (by rw [countsDomainPath_eq_monadTPower_listSum, hsum])
    (by rw [hlen]) (wordFromCounts counts)

/-- The flat word folds to its count vector's reconstruction — `monadMonotoneMapOf (kzFlatWord n m cs …) =
reconstructFrom 0 cs` — since the boundary cast is fold-invisible and `wordFromCounts` round-trips. -/
theorem kzFlatWord_map (widthTotal widthCod : Nat) (counts : List Nat)
    (hsum : listSum counts = widthTotal) (hlen : counts.length = widthCod) :
    monadMonotoneMapOf (kzFlatWord widthTotal widthCod counts hsum hlen) = reconstructFrom 0 counts := by
  rw [kzFlatWord, monadMonotoneMapOf_castBoundary, monadMonotoneMapOf_wordFromCounts]

/-- Two flat words of the SAME `(n,m)` whose count vectors reconstruct to the SAME map are KZ-`≤` (both ways) —
the EQUALITY-completeness bridge at the flat boundary, cast-free (they are parallel). -/
theorem kzLE_ofFlatMapEq (widthTotal widthCod : Nat) {counts counts' : List Nat}
    (hsum : listSum counts = widthTotal) (hlen : counts.length = widthCod)
    (hsum' : listSum counts' = widthTotal) (hlen' : counts'.length = widthCod)
    (hmap : reconstructFrom 0 counts = reconstructFrom 0 counts') :
    KZTwoCellLE (kzFlatWord widthTotal widthCod counts hsum hlen)
      (kzFlatWord widthTotal widthCod counts' hsum' hlen') :=
  kzLE_ofMapEq (by rw [kzFlatWord_map, kzFlatWord_map, hmap])

/-! ## ★★ The LOCAL covering move on merged fibre-count vectors -/

/-- ★★ **The LOCAL 2-block covering** `flat [a+1,b] ⇒ flat [a,b+1]` at the flat boundary `(t^n, t^2)` — the
general covering move `(a+1, b) ↦ (a, b+1)` that moves ONE fibre unit rightward between two adjacent MERGED
target blocks.  Realized as the atomic move between the UNMERGED 4-block words `[a,1,0,b] ⇒ [a,0,1,b]`
(`kzAtomicCovering`, the whiskered `kzGen`), post-composed with the fixed merge `word [2,2]` (fold `[0,0,1,1]`):
the source endpoint folds `composeMap (reconstruct [a,1,0,b]) [0,0,1,1] = reconstruct [a+1,b]`
(`mergeCollapse_srcCounts`) and the target `= reconstruct [a,b+1]` (`mergeCollapse_tgtCounts`), so both endpoints
bridge to the merged flat words by EQUALITY completeness.  The whole chain lives at `(t^n, t^2)`, so every step is
cast-free `vcompCongrLeft` / `kzLE_ofMapEq`.  This is the covering-word brick the completeness chain iterates. -/
theorem kzLocalCovering (widthLeft widthRight widthTotal : Nat)
    (hsumSrc : listSum [widthLeft + 1, widthRight] = widthTotal)
    (hsumTgt : listSum [widthLeft, widthRight + 1] = widthTotal) :
    KZTwoCellLE (kzFlatWord widthTotal 2 [widthLeft + 1, widthRight] hsumSrc rfl)
      (kzFlatWord widthTotal 2 [widthLeft, widthRight + 1] hsumTgt rfl) := by
  -- The two unmerged 4-block words also have block sum `widthTotal`.
  have hsum4Src : listSum [widthLeft, 1, 0, widthRight] = widthTotal := by
    have hstep : listSum [widthLeft, 1, 0, widthRight] = listSum [widthLeft + 1, widthRight] := by
      show widthLeft + (1 + (0 + (widthRight + 0))) = (widthLeft + 1) + (widthRight + 0)
      rw [Nat.zero_add, Nat.add_zero, Nat.add_zero, ← Nat.add_assoc]
    rw [hstep, hsumSrc]
  have hsum4Tgt : listSum [widthLeft, 0, 1, widthRight] = widthTotal := by
    have hstep : listSum [widthLeft, 0, 1, widthRight] = listSum [widthLeft, widthRight + 1] := by
      show widthLeft + (0 + (1 + (widthRight + 0))) = widthLeft + ((widthRight + 1) + 0)
      rw [Nat.zero_add, Nat.add_zero, Nat.add_zero, Nat.add_comm 1 widthRight]
    rw [hstep, hsumTgt]
  have hsumMerge : listSum [2, 2] = 4 := rfl
  -- The atomic move, lifted to the flat 4-block boundary.
  have hAtomicFlat : KZTwoCellLE (kzFlatWord widthTotal 4 [widthLeft, 1, 0, widthRight] hsum4Src rfl)
      (kzFlatWord widthTotal 4 [widthLeft, 0, 1, widthRight] hsum4Tgt rfl) := by
    rw [kzFlatWord, kzFlatWord]
    exact KZTwoCellLE.castBoundaryCongr _ _ (kzAtomicCoveringLiteral widthLeft widthRight)
  -- The source merged word ≈ (flat 4-block src ⊟ merge), by the source merge collapse.
  refine KZTwoCellLE.trans
    (kzLE_ofMapEq (show monadMonotoneMapOf (kzFlatWord widthTotal 2 [widthLeft + 1, widthRight] hsumSrc rfl)
      = monadMonotoneMapOf (RawTwoCellExpr.vcomp (kzFlatWord widthTotal 4 [widthLeft, 1, 0, widthRight] hsum4Src rfl)
          (kzFlatWord 4 2 [2, 2] hsumMerge rfl)) from ?_)) ?_
  · rw [kzFlatWord_map, monadMonotoneMapOf_vcomp, kzFlatWord_map, kzFlatWord_map, mergeCollapse_srcCounts]
  -- The order step: (flat 4 src ⊟ merge) ⇒ (flat 4 tgt ⊟ merge) by the atomic move.
  refine KZTwoCellLE.trans (KZTwoCellLE.vcompCongrLeft (kzFlatWord 4 2 [2, 2] hsumMerge rfl) hAtomicFlat) ?_
  -- (flat 4 tgt ⊟ merge) ≈ target merged word, by the target merge collapse.
  refine kzLE_ofMapEq
    (show monadMonotoneMapOf (RawTwoCellExpr.vcomp (kzFlatWord widthTotal 4 [widthLeft, 0, 1, widthRight] hsum4Tgt rfl)
        (kzFlatWord 4 2 [2, 2] hsumMerge rfl))
      = monadMonotoneMapOf (kzFlatWord widthTotal 2 [widthLeft, widthRight + 1] hsumTgt rfl) from ?_)
  rw [monadMonotoneMapOf_vcomp, kzFlatWord_map, kzFlatWord_map, kzFlatWord_map, mergeCollapse_tgtCounts]

/-! ## Non-vacuity: the covering move is genuine and strictly directional -/

/-- ★ **Non-vacuity — the base covering IS the strict KZ pair.**  At `widthLeft = widthRight = 0` the local
covering is `word [1,0] ⇒ word [0,1]`, folds `[0] ≤ [1]` — the strict directional generator `t◁eta ≤ eta▷t`
whose reverse is REFUTED (`kz_strict`).  So the covering move is non-vacuous and carries the genuine
lax-idempotency direction, not an equality. -/
theorem kzBaseCovering_isStrict :
    KZTwoCellLE (wordFromCounts [1, 0]) (wordFromCounts [0, 1])
      ∧ ¬ KZTwoCellLE (wordFromCounts [0, 1]) (wordFromCounts [1, 0]) := by
  refine ⟨kzBaseCovering, ?_⟩
  intro le
  have hsound := kzLE_sound le
  have hMapUpper : monadMonotoneMapOf (wordFromCounts [0, 1]) = [1] := by
    rw [monadMonotoneMapOf_wordFromCounts]; rfl
  have hMapLower : monadMonotoneMapOf (wordFromCounts [1, 0]) = [0] := by
    rw [monadMonotoneMapOf_wordFromCounts]; rfl
  have hStrict : mapLE [1] [0] := by rw [← hMapUpper, ← hMapLower]; exact hsound
  exact not_mapLE10 hStrict

/-- ★ Non-vacuity — a genuinely MERGED covering move fires: `flat [2,1] ⇒ flat [1,2]` (folds `[0,0,1] ≤ [0,1,1]`,
the middle strand moves rightward out of the width-2 merge).  `kzLocalCovering 1 1 3` instantiated. -/
theorem kzLocalCovering_merged_smoke :
    KZTwoCellLE (kzFlatWord 3 2 [2, 1] rfl rfl) (kzFlatWord 3 2 [1, 2] rfl rfl) :=

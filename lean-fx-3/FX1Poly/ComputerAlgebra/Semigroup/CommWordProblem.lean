/-! # FX1Poly/ComputerAlgebra/Semigroup/CommWordProblem — the commutative-semigroup
    word problem (NET-3)

A **word** over the generators `{x0, x1, ...}` is a `List Nat` (each entry a generator
index).  The **free commutative monoid** on those generators is the quotient of words by
the congruence generated by commutativity of adjacent letters.  Two words are equal in the
free commutative monoid iff they are permutations of each other, iff they carry the same
multiset of letters, iff their **sorted normal forms** coincide.

This file decides that free fragment END-TO-END, zero-axiom, and then addresses the
finitely-**presented** case (generators + relations).

## What is DECIDED (zero-axiom)

* **T1 — the free commutative-monoid word problem.**  The congruence `CswCongr` is the
  equivalence generated by adjacent transposition in any context.  The normal form
  `cswSort` is insertion sort of the letter list.  We prove BOTH directions:
  `cswDecideFreeWord w w' = true  ↔  CswCongr w w'`
  (`cswFreeWordDecisionCorrect`), i.e. the decision is sound and complete.  The hard lemma
  is `cswInsertComm` (sorted insertion commutes); the two bridges are `cswCongrToSort`
  (every word is congruent to its sort) and `cswCongrToExpEq` (congruent words sort equal).

* **T2 (positive half) — the presented case via a checkable rewrite certificate.**  A
  presentation is a `List (List Nat × List Nat)` of relation pairs; `CswPresCongr rels` is
  the congruence generated by commutativity PLUS relation application in any context (in
  either direction).  `cswCheckDerivation` verifies a witnessed rewrite path and
  `cswCheckDerivationSound` proves that a checked path yields a genuine congruence — the
  POSITIVE decision half.  `cswFreeToPres` embeds the free congruence into any presented
  one.

## What is WALLED

* **T3 — the FULL two-sided presented decision** (`membership ∨ ¬membership`).  Deciding
  NON-congruence needs a confluent terminating completion (Buchberger over the binomial
  ideal, or vector rewriting over `Nat^k`).  Both terminate only via **Dickson's lemma /
  the almost-full product**, which is a certified zero-axiom IMPOSSIBILITY in this repo
  (`FX1Poly.ComputerAlgebra.fxNet4_dicksonWall = false`; the both-`later` AF-product case
  needs `WellFounded.fix`).  The shipped Gröbner engine likewise carries only a one-sided
  certificate route (`fxDissatGrob_hasNonMembershipDecision = false`).  Marker:
  `cswHasPresentedCommWordDecision = false`.

Every declaration is free of `propext`, `Quot.sound`, `Classical.choice`, `sorry`,
`native_decide`, `omega`, `funext`, `WellFounded.fix`.  All `Nat` order facts are
hand-rolled structural recursions; no leak-prone library order/append lemma is used. -/

namespace FX1Poly.ComputerAlgebra

/-! ## Boolean and `Nat` micro-kit (structural, propext-clean) -/

/-- `cond` on a `true` scrutinee. -/
theorem cswCondTrue {carrier : Type} (whenTrue whenFalse : carrier) :
    cond true whenTrue whenFalse = whenTrue := rfl

/-- `cond` on a `false` scrutinee. -/
theorem cswCondFalse {carrier : Type} (whenTrue whenFalse : carrier) :
    cond false whenTrue whenFalse = whenFalse := rfl

/-- Eliminate a `true` conjunction into its two `true` halves. -/
theorem cswBoolAndElim : (leftFlag rightFlag : Bool) → (leftFlag && rightFlag) = true →
    leftFlag = true ∧ rightFlag = true
  | true, true, _ => ⟨rfl, rfl⟩
  | true, false, hBoth => Bool.noConfusion hBoth
  | false, true, hBoth => Bool.noConfusion hBoth
  | false, false, hBoth => Bool.noConfusion hBoth

/-- Reflexivity of `Nat.beq`. -/
theorem cswNatBeqRefl : (value : Nat) → Nat.beq value value = true
  | 0 => rfl
  | Nat.succ predecessor => cswNatBeqRefl predecessor

/-- `Nat.beq` sound: beq-true numbers are equal. -/
theorem cswNatBeqEq : (leftValue rightValue : Nat) → Nat.beq leftValue rightValue = true →
    leftValue = rightValue
  | 0, 0, _ => rfl
  | 0, Nat.succ _, hBeq => Bool.noConfusion hBeq
  | Nat.succ _, 0, hBeq => Bool.noConfusion hBeq
  | Nat.succ leftPredecessor, Nat.succ rightPredecessor, hBeq =>
      congrArg Nat.succ (cswNatBeqEq leftPredecessor rightPredecessor hBeq)

/-! ## The order comparator `cswLe` (structural; reflexive, total, antisymmetric, transitive) -/

/-- Structural `≤` on `Nat`. -/
def cswLe : Nat → Nat → Bool
  | 0, _ => true
  | Nat.succ _, 0 => false
  | Nat.succ leftPredecessor, Nat.succ rightPredecessor => cswLe leftPredecessor rightPredecessor

/-- `cswLe` is reflexive. -/
theorem cswLeRefl : (value : Nat) → cswLe value value = true
  | 0 => rfl
  | Nat.succ predecessor => cswLeRefl predecessor

/-- `cswLe` is total: if one direction is `false`, the other is `true`. -/
theorem cswLeTotal : (leftValue rightValue : Nat) →
    cswLe leftValue rightValue = false → cswLe rightValue leftValue = true
  | 0, _, hFalse => Bool.noConfusion hFalse
  | Nat.succ _, 0, _ => rfl
  | Nat.succ leftPredecessor, Nat.succ rightPredecessor, hFalse =>
      cswLeTotal leftPredecessor rightPredecessor hFalse

/-- `cswLe` is antisymmetric: mutual `≤` forces equality. -/
theorem cswLeAntisym : (leftValue rightValue : Nat) →
    cswLe leftValue rightValue = true → cswLe rightValue leftValue = true →
    leftValue = rightValue
  | 0, 0, _, _ => rfl
  | Nat.succ _, 0, hLeftRight, _ => Bool.noConfusion hLeftRight
  | 0, Nat.succ _, _, hRightLeft => Bool.noConfusion hRightLeft
  | Nat.succ leftPredecessor, Nat.succ rightPredecessor, hLeftRight, hRightLeft =>
      congrArg Nat.succ (cswLeAntisym leftPredecessor rightPredecessor hLeftRight hRightLeft)

/-- `cswLe` is transitive. -/
theorem cswLeTrans : (firstValue secondValue thirdValue : Nat) →
    cswLe firstValue secondValue = true → cswLe secondValue thirdValue = true →
    cswLe firstValue thirdValue = true
  | 0, _, _, _, _ => rfl
  | Nat.succ _, 0, _, hFirstSecond, _ => Bool.noConfusion hFirstSecond
  | Nat.succ _, Nat.succ _, 0, _, hSecondThird => Bool.noConfusion hSecondThird
  | Nat.succ firstPredecessor, Nat.succ secondPredecessor, Nat.succ thirdPredecessor,
      hFirstSecond, hSecondThird =>
      cswLeTrans firstPredecessor secondPredecessor thirdPredecessor hFirstSecond hSecondThird

/-! ## Decidable equality on letter lists -/

/-- Structural Boolean equality on `List Nat`. -/
def cswListNatBeq : List Nat → List Nat → Bool
  | [], [] => true
  | [], _ :: _ => false
  | _ :: _, [] => false
  | leftHead :: leftRest, rightHead :: rightRest =>
      Nat.beq leftHead rightHead && cswListNatBeq leftRest rightRest

/-- Reflexivity of `cswListNatBeq`. -/
theorem cswListNatBeqRefl : (letters : List Nat) → cswListNatBeq letters letters = true
  | [] => rfl
  | head :: rest => by
      show (Nat.beq head head && cswListNatBeq rest rest) = true
      rw [cswNatBeqRefl head, cswListNatBeqRefl rest]
      rfl

/-- `cswListNatBeq` sound: beq-true letter lists are equal. -/
theorem cswListNatBeqEq : (left right : List Nat) → cswListNatBeq left right = true → left = right
  | [], [], _ => rfl
  | [], _ :: _, hBeq => Bool.noConfusion hBeq
  | _ :: _, [], hBeq => Bool.noConfusion hBeq
  | leftHead :: leftRest, rightHead :: rightRest, hBeq => by
      have hSplit := cswBoolAndElim _ _ hBeq
      rw [cswNatBeqEq leftHead rightHead hSplit.left,
        cswListNatBeqEq leftRest rightRest hSplit.right]

/-! ## Insertion sort — the free commutative-monoid normal form -/

/-- Insert a letter into a sorted letter list, keeping ascending order. -/
def cswInsert (letter : Nat) : List Nat → List Nat
  | [] => [letter]
  | head :: rest => cond (cswLe letter head) (letter :: head :: rest) (head :: cswInsert letter rest)

/-- `cswInsert` on a head it is `≤`: it lands in front. -/
theorem cswInsertConsTrue (letter head : Nat) (rest : List Nat)
    (hLe : cswLe letter head = true) :
    cswInsert letter (head :: rest) = letter :: head :: rest := by
  show cond (cswLe letter head) (letter :: head :: rest) (head :: cswInsert letter rest)
      = letter :: head :: rest
  rw [hLe, cswCondTrue]

/-- `cswInsert` on a head it is not `≤`: it descends past that head. -/
theorem cswInsertConsFalse (letter head : Nat) (rest : List Nat)
    (hLe : cswLe letter head = false) :
    cswInsert letter (head :: rest) = head :: cswInsert letter rest := by
  show cond (cswLe letter head) (letter :: head :: rest) (head :: cswInsert letter rest)
      = head :: cswInsert letter rest
  rw [hLe, cswCondFalse]

/-- Insertion sort of a letter list. -/
def cswSort : List Nat → List Nat
  | [] => []
  | letter :: rest => cswInsert letter (cswSort rest)

/-- Fold `cswInsert` over a prefix of letters onto a base list. -/
def cswInsertAll : List Nat → List Nat → List Nat
  | [], base => base
  | letter :: front, base => cswInsert letter (cswInsertAll front base)

/-- `cswSort` distributes over `++` via `cswInsertAll`. -/
theorem cswSortAppend : (front rest : List Nat) →
    cswSort (front ++ rest) = cswInsertAll front (cswSort rest)
  | [], _ => rfl
  | letter :: front, rest => by
      show cswInsert letter (cswSort (front ++ rest))
          = cswInsert letter (cswInsertAll front (cswSort rest))
      rw [cswSortAppend front rest]

/-- Reordering two front letters over a common tail respects the sorted insert
of a single pair — the base commutation the swap generator needs. -/
theorem cswPairReorder (leftLetter rightLetter : Nat) (tail : List Nat) :
    cond (cswLe leftLetter rightLetter)
        (leftLetter :: rightLetter :: tail) (rightLetter :: leftLetter :: tail)
      = cond (cswLe rightLetter leftLetter)
        (rightLetter :: leftLetter :: tail) (leftLetter :: rightLetter :: tail) := by
  cases hLeftRight : cswLe leftLetter rightLetter with
  | true =>
      cases hRightLeft : cswLe rightLetter leftLetter with
      | true => rw [cswLeAntisym leftLetter rightLetter hLeftRight hRightLeft]
      | false => rfl
  | false =>
      rw [cswLeTotal leftLetter rightLetter hLeftRight]
      rfl

/-- **Sorted insertion commutes.**  The crux of free-commutative-monoid completeness. -/
theorem cswInsertComm : (leftLetter rightLetter : Nat) → (letters : List Nat) →
    cswInsert leftLetter (cswInsert rightLetter letters)
      = cswInsert rightLetter (cswInsert leftLetter letters)
  | leftLetter, rightLetter, [] => by
      show cond (cswLe leftLetter rightLetter)
            (leftLetter :: rightLetter :: []) (rightLetter :: leftLetter :: [])
          = cond (cswLe rightLetter leftLetter)
            (rightLetter :: leftLetter :: []) (leftLetter :: rightLetter :: [])
      exact cswPairReorder leftLetter rightLetter []
  | leftLetter, rightLetter, head :: rest => by
      cases hRightHead : cswLe rightLetter head with
      | true =>
          cases hLeftHead : cswLe leftLetter head with
          | true =>
              rw [cswInsertConsTrue rightLetter head rest hRightHead,
                cswInsertConsTrue leftLetter head rest hLeftHead]
              show cond (cswLe leftLetter rightLetter)
                    (leftLetter :: rightLetter :: head :: rest)
                    (rightLetter :: cswInsert leftLetter (head :: rest))
                  = cond (cswLe rightLetter leftLetter)
                    (rightLetter :: leftLetter :: head :: rest)
                    (leftLetter :: cswInsert rightLetter (head :: rest))
              rw [cswInsertConsTrue leftLetter head rest hLeftHead,
                cswInsertConsTrue rightLetter head rest hRightHead]
              exact cswPairReorder leftLetter rightLetter (head :: rest)
          | false =>
              have hLeftRight : cswLe leftLetter rightLetter = false := by
                cases hCheck : cswLe leftLetter rightLetter with
                | false => rfl
                | true =>
                    have hDerived : cswLe leftLetter head = true :=
                      cswLeTrans leftLetter rightLetter head hCheck hRightHead
                    rw [hDerived] at hLeftHead
                    exact Bool.noConfusion hLeftHead
              rw [cswInsertConsTrue rightLetter head rest hRightHead,
                cswInsertConsFalse leftLetter head rest hLeftHead,
                cswInsertConsFalse leftLetter rightLetter (head :: rest) hLeftRight,
                cswInsertConsFalse leftLetter head rest hLeftHead,
                cswInsertConsTrue rightLetter head (cswInsert leftLetter rest) hRightHead]
      | false =>
          cases hLeftHead : cswLe leftLetter head with
          | true =>
              have hRightLeft : cswLe rightLetter leftLetter = false := by
                cases hCheck : cswLe rightLetter leftLetter with
                | false => rfl
                | true =>
                    have hDerived : cswLe rightLetter head = true :=
                      cswLeTrans rightLetter leftLetter head hCheck hLeftHead
                    rw [hDerived] at hRightHead
                    exact Bool.noConfusion hRightHead
              rw [cswInsertConsFalse rightLetter head rest hRightHead,
                cswInsertConsTrue leftLetter head rest hLeftHead,
                cswInsertConsTrue leftLetter head (cswInsert rightLetter rest) hLeftHead,
                cswInsertConsFalse rightLetter leftLetter (head :: rest) hRightLeft,
                cswInsertConsFalse rightLetter head rest hRightHead]
          | false =>
              rw [cswInsertConsFalse rightLetter head rest hRightHead,
                cswInsertConsFalse leftLetter head rest hLeftHead,
                cswInsertConsFalse leftLetter head (cswInsert rightLetter rest) hLeftHead,
                cswInsertConsFalse rightLetter head (cswInsert leftLetter rest) hRightHead]
              exact congrArg (fun sorted => head :: sorted)
                (cswInsertComm leftLetter rightLetter rest)

/-! ## The free commutative-monoid congruence and its decision -/

/-- The free commutative-monoid congruence on words: the equivalence closure of adjacent
transposition in any context (commutativity of the generators). -/
inductive CswCongr : List Nat → List Nat → Prop
  | refl (word : List Nat) : CswCongr word word
  | swap (front : List Nat) (leftLetter rightLetter : Nat) (back : List Nat) :
      CswCongr (front ++ leftLetter :: rightLetter :: back)
        (front ++ rightLetter :: leftLetter :: back)
  | trans {left middle right : List Nat} :
      CswCongr left middle → CswCongr middle right → CswCongr left right

/-- The congruence is symmetric (swap is its own reverse; refl/trans dualize). -/
theorem cswCongrSymm {left right : List Nat} (hCongr : CswCongr left right) :
    CswCongr right left := by
  induction hCongr with
  | refl word => exact CswCongr.refl word
  | swap front leftLetter rightLetter back =>
      exact CswCongr.swap front rightLetter leftLetter back
  | trans _ _ ihLeft ihRight => exact CswCongr.trans ihRight ihLeft

/-- The congruence is closed under prepending a common letter. -/
theorem cswCongrCons (letter : Nat) {left right : List Nat} (hCongr : CswCongr left right) :
    CswCongr (letter :: left) (letter :: right) := by
  induction hCongr with
  | refl word => exact CswCongr.refl (letter :: word)
  | swap front leftLetter rightLetter back =>
      exact CswCongr.swap (letter :: front) leftLetter rightLetter back
  | trans _ _ ihLeft ihRight => exact CswCongr.trans ihLeft ihRight

/-- Inserting a letter is congruent to prepending it (bubble it down through the sort). -/
theorem cswInsertCongrPrepend (letter : Nat) :
    (letters : List Nat) → CswCongr (letter :: letters) (cswInsert letter letters)
  | [] => CswCongr.refl [letter]
  | head :: rest => by
      cases hLe : cswLe letter head with
      | true =>
          rw [cswInsertConsTrue letter head rest hLe]
          exact CswCongr.refl (letter :: head :: rest)
      | false =>
          rw [cswInsertConsFalse letter head rest hLe]
          exact CswCongr.trans (CswCongr.swap [] letter head rest)
            (cswCongrCons head (cswInsertCongrPrepend letter rest))

/-- Every word is congruent to its sorted normal form. -/
theorem cswCongrToSort : (word : List Nat) → CswCongr word (cswSort word)
  | [] => CswCongr.refl []
  | letter :: rest =>
      CswCongr.trans (cswCongrCons letter (cswCongrToSort rest))
        (cswInsertCongrPrepend letter (cswSort rest))

/-- Congruent words sort to the same normal form (completeness core). -/
theorem cswCongrToExpEq {left right : List Nat} (hCongr : CswCongr left right) :
    cswSort left = cswSort right := by
  induction hCongr with
  | refl _ => rfl
  | swap front leftLetter rightLetter back =>
      rw [cswSortAppend front (leftLetter :: rightLetter :: back),
        cswSortAppend front (rightLetter :: leftLetter :: back)]
      exact congrArg (cswInsertAll front)
        (cswInsertComm leftLetter rightLetter (cswSort back))
  | trans _ _ ihLeft ihRight => exact Eq.trans ihLeft ihRight

/-- **The free commutative-monoid word decision.**  Compare sorted normal forms. -/
def cswDecideFreeWord (left right : List Nat) : Bool :=
  cswListNatBeq (cswSort left) (cswSort right)

/-- Soundness: an accepted pair is genuinely congruent. -/
theorem cswDecideFreeWordSound {left right : List Nat}
    (hDecide : cswDecideFreeWord left right = true) : CswCongr left right := by
  have hSortEq : cswSort left = cswSort right :=
    cswListNatBeqEq (cswSort left) (cswSort right) hDecide
  have hLeft : CswCongr left (cswSort left) := cswCongrToSort left
  have hRight : CswCongr (cswSort right) right := cswCongrSymm (cswCongrToSort right)
  rw [hSortEq] at hLeft
  exact CswCongr.trans hLeft hRight

/-- Completeness: every congruent pair is accepted. -/
theorem cswDecideFreeWordComplete {left right : List Nat}
    (hCongr : CswCongr left right) : cswDecideFreeWord left right = true := by
  show cswListNatBeq (cswSort left) (cswSort right) = true
  rw [cswCongrToExpEq hCongr]
  exact cswListNatBeqRefl (cswSort right)

/-- **T1 headline: the free commutative-monoid word problem is decided.** -/
theorem cswFreeWordDecisionCorrect (left right : List Nat) :
    cswDecideFreeWord left right = true ↔ CswCongr left right :=
  Iff.intro cswDecideFreeWordSound cswDecideFreeWordComplete

/-! ## T2 — the finitely-presented case -/

/-- A presentation's relation table: a list of word pairs `u = v`. -/
abbrev CswRelations := List (List Nat × List Nat)

/-- Is the oriented pair `(left, right)` a listed relation? -/
def cswRelMemBool : CswRelations → List Nat → List Nat → Bool
  | [], _, _ => false
  | (source, target) :: rest, left, right =>
      (cswListNatBeq source left && cswListNatBeq target right)
        || cswRelMemBool rest left right

/-- The presented congruence: commutativity PLUS relation application in any context,
closed under refl / symm / trans. -/
inductive CswPresCongr (rels : CswRelations) : List Nat → List Nat → Prop
  | refl (word : List Nat) : CswPresCongr rels word word
  | swap (front : List Nat) (leftLetter rightLetter : Nat) (back : List Nat) :
      CswPresCongr rels (front ++ leftLetter :: rightLetter :: back)
        (front ++ rightLetter :: leftLetter :: back)
  | rel (source target : List Nat) (hMem : cswRelMemBool rels source target = true)
      (front back : List Nat) :
      CswPresCongr rels (front ++ source ++ back) (front ++ target ++ back)
  | symm {left right : List Nat} : CswPresCongr rels left right → CswPresCongr rels right left
  | trans {left middle right : List Nat} :
      CswPresCongr rels left middle → CswPresCongr rels middle right → CswPresCongr rels left right

/-- The free congruence embeds into every presented congruence. -/
theorem cswFreeToPres (rels : CswRelations) {left right : List Nat}
    (hCongr : CswCongr left right) : CswPresCongr rels left right := by
  induction hCongr with
  | refl word => exact CswPresCongr.refl word
  | swap front leftLetter rightLetter back =>
      exact CswPresCongr.swap front leftLetter rightLetter back
  | trans _ _ ihLeft ihRight => exact CswPresCongr.trans ihLeft ihRight

/-! ### Checkable rewrite certificates — the POSITIVE presented-decision half -/

/-- One witnessed rewrite step: an adjacent commutation, or a relation applied in a context. -/
inductive CswStepWitness where
  | commStep (front : List Nat) (leftLetter rightLetter : Nat) (back : List Nat)
  | relStep (source target : List Nat) (front back : List Nat)

/-- The word a step starts from. -/
def cswStepSource : CswStepWitness → List Nat
  | CswStepWitness.commStep front leftLetter rightLetter back =>
      front ++ leftLetter :: rightLetter :: back
  | CswStepWitness.relStep source _ front back => front ++ source ++ back

/-- The word a step ends at. -/
def cswStepTarget : CswStepWitness → List Nat
  | CswStepWitness.commStep front leftLetter rightLetter back =>
      front ++ rightLetter :: leftLetter :: back
  | CswStepWitness.relStep _ target front back => front ++ target ++ back

/-- A step is valid against a presentation: commutation always; a relation step needs its
pair listed in either orientation. -/
def cswStepValid (rels : CswRelations) : CswStepWitness → Bool
  | CswStepWitness.commStep _ _ _ _ => true
  | CswStepWitness.relStep source target _ _ =>
      cswRelMemBool rels source target || cswRelMemBool rels target source

/-- A valid step is a genuine presented congruence between its endpoints. -/
theorem cswStepGenerator (rels : CswRelations) (step : CswStepWitness)
    (hValid : cswStepValid rels step = true) :
    CswPresCongr rels (cswStepSource step) (cswStepTarget step) := by
  cases step with
  | commStep front leftLetter rightLetter back =>
      exact CswPresCongr.swap front leftLetter rightLetter back
  | relStep source target front back =>
      have hOr : (cswRelMemBool rels source target || cswRelMemBool rels target source) = true :=
        hValid
      cases hForward : cswRelMemBool rels source target with
      | true => exact CswPresCongr.rel source target hForward front back
      | false =>
          have hBackward : cswRelMemBool rels target source = true := by
            rw [hForward] at hOr
            exact hOr
          exact CswPresCongr.symm (CswPresCongr.rel target source hBackward front back)

/-- The rewrite-path checker: thread the current word through each witnessed step, then
match the target.  A `true` verdict is a genuine derivation. -/
def cswCheckDerivation (rels : CswRelations) : List Nat → List CswStepWitness → List Nat → Bool
  | current, [], target => cswListNatBeq current target
  | current, step :: rest, target =>
      (cswStepValid rels step && cswListNatBeq current (cswStepSource step))
        && cswCheckDerivation rels (cswStepTarget step) rest target

/-- **T2 positive headline: a checked rewrite path is a genuine presented congruence.** -/
theorem cswCheckDerivationSound (rels : CswRelations) :
    (steps : List CswStepWitness) → (current target : List Nat) →
    cswCheckDerivation rels current steps target = true →
    CswPresCongr rels current target
  | [], current, target, hCheck => by
      have hEq : current = target := cswListNatBeqEq current target hCheck
      rw [hEq]
      exact CswPresCongr.refl target
  | step :: rest, current, target, hCheck => by
      have hSplit := cswBoolAndElim _ _ hCheck
      have hStep := cswBoolAndElim _ _ hSplit.left
      have hValid : cswStepValid rels step = true := hStep.left
      have hBeq : cswListNatBeq current (cswStepSource step) = true := hStep.right
      have hRec : cswCheckDerivation rels (cswStepTarget step) rest target = true := hSplit.right
      have hCurrent : current = cswStepSource step :=
        cswListNatBeqEq current (cswStepSource step) hBeq
      have hGenerator : CswPresCongr rels (cswStepSource step) (cswStepTarget step) :=
        cswStepGenerator rels step hValid
      have hTail : CswPresCongr rels (cswStepTarget step) target :=
        cswCheckDerivationSound rels rest (cswStepTarget step) target hRec
      rw [hCurrent]
      exact CswPresCongr.trans hGenerator hTail

/-! ## T3 — the honest wall + capability markers -/

/-- Owner marker: the FREE commutative-monoid word problem IS decided (T1). -/
def cswHasFreeCommWordDecision : Bool := true

/-- Owner marker: the presented case has a sound POSITIVE certificate route (T2). -/
def cswHasPresentedPositiveCertificate : Bool := true

/-- Owner marker (WALL): the FULL two-sided presented commutative-semigroup word decision
is NOT delivered.  Deciding NON-congruence needs a confluent terminating completion whose
termination is Dickson's lemma / the almost-full product — a certified zero-axiom
impossibility here (`fxNet4_dicksonWall = false`, needs `WellFounded.fix` for the both-later
AF-product case); the shipped Gröbner engine carries only a one-sided certificate
(`fxDissatGrob_hasNonMembershipDecision = false`).  The two burned attacks: (1) binomial
ideal membership over the shipped multivariate Gröbner engine — one-sided (verified checker
+ untrusted fuel finder), cannot refute; (2) direct vector rewriting over `Nat^k` — its
termination is exactly the walled AF-product. -/
def cswHasPresentedCommWordDecision : Bool := false

/-! ## T4 — ground fires -/

/-- `x*y*x` and `x*x*y` share the exponent vector `x^2 y` ⟹ free-congruent. -/
theorem cswFireEqualExponents : cswDecideFreeWord [0, 1, 0] [0, 0, 1] = true := rfl

/-- `x*x*y` and `x*y*y` differ (`x^2 y` vs `x y^2`) ⟹ not free-congruent. -/
theorem cswFireDifferentExponents : cswDecideFreeWord [0, 0, 1] [0, 1, 1] = false := rfl

/-- A single generator `x` is not free-congruent to a single generator `y` (control). -/
theorem cswFireDistinctSingletons : cswDecideFreeWord [0] [1] = false := rfl

/-- Presented fire: with the relation `x*x = y` (`[0,0] = [1]`), the word `x*x*x`
rewrites to `x*y`: apply the relation on the leading `x*x` (target `y*x`), then commute. -/
theorem cswFirePresentedDerivationChecks :
    cswCheckDerivation [([0, 0], [1])] [0, 0, 0]
        [CswStepWitness.relStep [0, 0] [1] [] [0], CswStepWitness.commStep [] 1 0 []]
        [0, 1] = true := rfl

/-- ...and that checked path yields a genuine presented congruence `x*x*x ~ x*y`. -/
theorem cswFirePresentedCongruent :
    CswPresCongr [([0, 0], [1])] [0, 0, 0] [0, 1] :=
  cswCheckDerivationSound [([0, 0], [1])] _ _ _ cswFirePresentedDerivationChecks

end FX1Poly.ComputerAlgebra

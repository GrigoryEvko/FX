import FX1Poly.ComputerAlgebra.Semigroup.CommWordProblem

/-! # Mazurkiewicz trace equivalence

A trace alphabet is the generator indices `Sigma = Nat` together with a dependence relation
`dependence : Nat -> Nat -> Bool` (reflexivity and symmetry are carried as hypotheses
`hRefl`, `hSym` where needed, not bundled).  A word is a `List Nat`.  The Mazurkiewicz trace
monoid identifies two words whenever one is obtained from the other by transposing two
adjacent independent letters (`p`, `q` with `dependence p q = false`); deciding this
partially-commutative word problem is the trace word problem.

It is decided end to end, zero-axiom, by the Cartier-Foata / Keller projection criterion:
two words are trace-equivalent iff, for every dependent pair `(a, b)`, the projection onto
`{a, b}` (the subsequence of letters equal to `a` or `b`) is identical in both — the diagonal
`(a, a)` projections force equal letter counts, subsuming the same-multiset requirement.

`MztTraceCongr dependence` is the equivalence generated by adjacent-independent transposition
in any context (refl / adjacentSwap / symm / trans), with cons-congruence
`mztTraceCongrCons`.  `mztKeepAB a b` projects a word onto `{a, b}` and `mztDecideTraceEqBool`
checks, over the finite carrier of dependent pairs occurring in the two words, that the
projections agree.

Soundness (`mztDecideSoundOfCongr`) is semantic: an adjacent-independent swap preserves every
dependent-pair projection (`mztCongrPreservesKeepAB`), since two independent letters cannot
both survive one dependent-pair projection.  Completeness (Keller's theorem / Cartier-Foata:
`mztProjAgreeComplete` semantically, `mztDecideCompleteOfDecide` in Boolean form) inducts on
the left word: the head letter `a` is bubbled to the front of the right word by independent
swaps — legal because no letter dependent on `a` can precede `a` there, else the `{a, x}`
projection would disagree (`mztBubbleHead`) — then the common head is stripped and the tails
recurse (`mztKeepABConsInj`).  Termination is structural.  The Boolean bridge
`mztDecideToProjAgree` finitizes "every dependent pair" to the letters occurring in the
inputs; `mztTraceDecisionCorrect` states
`mztDecideTraceEqBool dep u v = true <-> MztTraceCongr dep u v`.

Every declaration is free of `propext`, `Quot.sound`, `Classical.choice`, `sorry`,
`native_decide`, `omega`, `funext`, `WellFounded.fix`.  The `Nat`/`List`-equality kit is
imported from `CommWordProblem`; everything else is hand-rolled structural recursion. -/

namespace FX1Poly.ComputerAlgebra

/-! ## Boolean micro-kit (structural, propext-clean) -/

/-- Right absorption of `true` under `||`. -/
theorem mztOrTrueRight : (flag : Bool) → (flag || true) = true
  | true => rfl
  | false => rfl

/-- Associativity of Boolean `||`. -/
theorem mztOrAssoc : (leftFlag middleFlag rightFlag : Bool) →
    (leftFlag || (middleFlag || rightFlag)) = ((leftFlag || middleFlag) || rightFlag)
  | true, _, _ => rfl
  | false, _, _ => rfl

/-- A `false` disjunction splits into two `false` halves. -/
theorem mztOrFalseElim : (leftFlag rightFlag : Bool) → (leftFlag || rightFlag) = false →
    leftFlag = false ∧ rightFlag = false
  | false, false, _ => ⟨rfl, rfl⟩
  | true, _, hBoth => Bool.noConfusion hBoth
  | false, true, hBoth => Bool.noConfusion hBoth

/-- The keep-test on a head equal (via `Nat.beq`) to the first projection letter is `true`. -/
theorem mztKeepTestSelfLeft (head other : Nat) :
    (Nat.beq head head || Nat.beq head other) = true := by
  rw [cswNatBeqRefl head]; rfl

/-- The keep-test on a head equal (via `Nat.beq`) to the second projection letter is `true`. -/
theorem mztKeepTestSelfRight (head other : Nat) :
    (Nat.beq head other || Nat.beq head head) = true := by
  rw [cswNatBeqRefl head]
  exact mztOrTrueRight (Nat.beq head other)

/-! ## The dependent-pair projection `mztKeepAB` -/

/-- Project a word onto the two-letter alphabet `{a, b}`: keep letters equal to `a` or `b`. -/
def mztKeepAB (firstLetter secondLetter : Nat) : List Nat → List Nat
  | [] => []
  | head :: rest =>
      cond (Nat.beq head firstLetter || Nat.beq head secondLetter)
        (head :: mztKeepAB firstLetter secondLetter rest)
        (mztKeepAB firstLetter secondLetter rest)

/-- `mztKeepAB` keeps a head that passes the keep-test. -/
theorem mztKeepABConsKeep (firstLetter secondLetter head : Nat) (rest : List Nat)
    (hKeep : (Nat.beq head firstLetter || Nat.beq head secondLetter) = true) :
    mztKeepAB firstLetter secondLetter (head :: rest)
      = head :: mztKeepAB firstLetter secondLetter rest := by
  show cond (Nat.beq head firstLetter || Nat.beq head secondLetter)
        (head :: mztKeepAB firstLetter secondLetter rest)
        (mztKeepAB firstLetter secondLetter rest)
      = head :: mztKeepAB firstLetter secondLetter rest
  rw [hKeep]; rfl

/-- `mztKeepAB` drops a head that fails the keep-test. -/
theorem mztKeepABConsDrop (firstLetter secondLetter head : Nat) (rest : List Nat)
    (hDrop : (Nat.beq head firstLetter || Nat.beq head secondLetter) = false) :
    mztKeepAB firstLetter secondLetter (head :: rest)
      = mztKeepAB firstLetter secondLetter rest := by
  show cond (Nat.beq head firstLetter || Nat.beq head secondLetter)
        (head :: mztKeepAB firstLetter secondLetter rest)
        (mztKeepAB firstLetter secondLetter rest)
      = mztKeepAB firstLetter secondLetter rest
  rw [hDrop]; rfl

/-- `mztKeepAB` distributes over `++`. -/
theorem mztKeepABAppend (firstLetter secondLetter : Nat) :
    (front tail : List Nat) →
    mztKeepAB firstLetter secondLetter (front ++ tail)
      = mztKeepAB firstLetter secondLetter front ++ mztKeepAB firstLetter secondLetter tail
  | [], _ => rfl
  | head :: rest, tail => by
      show mztKeepAB firstLetter secondLetter (head :: (rest ++ tail))
          = mztKeepAB firstLetter secondLetter (head :: rest)
            ++ mztKeepAB firstLetter secondLetter tail
      cases hKeep : (Nat.beq head firstLetter || Nat.beq head secondLetter) with
      | true =>
          rw [mztKeepABConsKeep firstLetter secondLetter head (rest ++ tail) hKeep,
            mztKeepABConsKeep firstLetter secondLetter head rest hKeep]
          show head :: mztKeepAB firstLetter secondLetter (rest ++ tail)
              = head :: (mztKeepAB firstLetter secondLetter rest
                ++ mztKeepAB firstLetter secondLetter tail)
          rw [mztKeepABAppend firstLetter secondLetter rest tail]
      | false =>
          rw [mztKeepABConsDrop firstLetter secondLetter head (rest ++ tail) hKeep,
            mztKeepABConsDrop firstLetter secondLetter head rest hKeep]
          exact mztKeepABAppend firstLetter secondLetter rest tail

/-! ## The trace congruence -/

/-- The Mazurkiewicz trace congruence: the equivalence closure of adjacent-independent
transposition in any context.  `symm` is a constructor (a swap's reverse needs the reverse
independence witness, obtained via `dependence` symmetry only when reconstructing). -/
inductive MztTraceCongr (dependence : Nat → Nat → Bool) : List Nat → List Nat → Prop
  | refl (word : List Nat) : MztTraceCongr dependence word word
  | adjacentSwap (front : List Nat) (leftLetter rightLetter : Nat) (back : List Nat)
      (hIndep : dependence leftLetter rightLetter = false) :
      MztTraceCongr dependence (front ++ leftLetter :: rightLetter :: back)
        (front ++ rightLetter :: leftLetter :: back)
  | symm {left right : List Nat} :
      MztTraceCongr dependence left right → MztTraceCongr dependence right left
  | trans {left middle right : List Nat} :
      MztTraceCongr dependence left middle → MztTraceCongr dependence middle right →
      MztTraceCongr dependence left right

/-- The trace congruence is closed under prepending a common letter. -/
theorem mztTraceCongrCons (dependence : Nat → Nat → Bool) (letter : Nat)
    {left right : List Nat} (hCongr : MztTraceCongr dependence left right) :
    MztTraceCongr dependence (letter :: left) (letter :: right) := by
  induction hCongr with
  | refl word => exact MztTraceCongr.refl (letter :: word)
  | adjacentSwap front leftLetter rightLetter back hIndep =>
      exact MztTraceCongr.adjacentSwap (letter :: front) leftLetter rightLetter back hIndep
  | symm _ ih => exact MztTraceCongr.symm ih
  | trans _ _ ihLeft ihRight => exact MztTraceCongr.trans ihLeft ihRight

/-! ## Soundness core — an adjacent-independent swap preserves every dependent
projection -/

/-- When both swapped letters survive a dependent-pair projection, they must be equal. -/
theorem mztKeptPairEq (dependence : Nat → Nat → Bool)
    (hSym : ∀ leftValue rightValue, dependence leftValue rightValue
      = dependence rightValue leftValue)
    (firstLetter secondLetter : Nat) (hDep : dependence firstLetter secondLetter = true)
    (leftLetter rightLetter : Nat) (hIndep : dependence leftLetter rightLetter = false)
    (hKeepLeft : (Nat.beq leftLetter firstLetter || Nat.beq leftLetter secondLetter) = true)
    (hKeepRight : (Nat.beq rightLetter firstLetter || Nat.beq rightLetter secondLetter) = true) :
    leftLetter = rightLetter := by
  cases hLeftFirst : Nat.beq leftLetter firstLetter with
  | true =>
      have hLeftEq : leftLetter = firstLetter := cswNatBeqEq leftLetter firstLetter hLeftFirst
      cases hRightFirst : Nat.beq rightLetter firstLetter with
      | true =>
          have hRightEq : rightLetter = firstLetter :=
            cswNatBeqEq rightLetter firstLetter hRightFirst
          rw [hLeftEq, hRightEq]
      | false =>
          have hRightSecond : Nat.beq rightLetter secondLetter = true := by
            rw [hRightFirst] at hKeepRight
            exact hKeepRight
          have hRightEq : rightLetter = secondLetter :=
            cswNatBeqEq rightLetter secondLetter hRightSecond
          rw [hLeftEq, hRightEq] at hIndep
          rw [hDep] at hIndep
          exact Bool.noConfusion hIndep
  | false =>
      have hLeftSecond : Nat.beq leftLetter secondLetter = true := by
        rw [hLeftFirst] at hKeepLeft
        exact hKeepLeft
      have hLeftEq : leftLetter = secondLetter := cswNatBeqEq leftLetter secondLetter hLeftSecond
      cases hRightFirst : Nat.beq rightLetter firstLetter with
      | true =>
          have hRightEq : rightLetter = firstLetter :=
            cswNatBeqEq rightLetter firstLetter hRightFirst
          rw [hLeftEq, hRightEq] at hIndep
          rw [hSym firstLetter secondLetter] at hDep
          rw [hDep] at hIndep
          exact Bool.noConfusion hIndep
      | false =>
          have hRightSecond : Nat.beq rightLetter secondLetter = true := by
            rw [hRightFirst] at hKeepRight
            exact hKeepRight
          have hRightEq : rightLetter = secondLetter :=
            cswNatBeqEq rightLetter secondLetter hRightSecond
          rw [hLeftEq, hRightEq]

/-- Transposing two adjacent independent letters leaves every dependent-pair projection
unchanged. -/
theorem mztKeepABSwapPair (dependence : Nat → Nat → Bool)
    (hSym : ∀ leftValue rightValue, dependence leftValue rightValue
      = dependence rightValue leftValue)
    (firstLetter secondLetter : Nat) (hDep : dependence firstLetter secondLetter = true)
    (leftLetter rightLetter : Nat) (hIndep : dependence leftLetter rightLetter = false)
    (back : List Nat) :
    mztKeepAB firstLetter secondLetter (leftLetter :: rightLetter :: back)
      = mztKeepAB firstLetter secondLetter (rightLetter :: leftLetter :: back) := by
  cases hKeepLeft : (Nat.beq leftLetter firstLetter || Nat.beq leftLetter secondLetter) with
  | false =>
      cases hKeepRight : (Nat.beq rightLetter firstLetter || Nat.beq rightLetter secondLetter) with
      | false =>
          rw [mztKeepABConsDrop firstLetter secondLetter leftLetter (rightLetter :: back) hKeepLeft,
            mztKeepABConsDrop firstLetter secondLetter rightLetter back hKeepRight,
            mztKeepABConsDrop firstLetter secondLetter rightLetter (leftLetter :: back) hKeepRight,
            mztKeepABConsDrop firstLetter secondLetter leftLetter back hKeepLeft]
      | true =>
          rw [mztKeepABConsDrop firstLetter secondLetter leftLetter (rightLetter :: back) hKeepLeft,
            mztKeepABConsKeep firstLetter secondLetter rightLetter back hKeepRight,
            mztKeepABConsKeep firstLetter secondLetter rightLetter (leftLetter :: back) hKeepRight,
            mztKeepABConsDrop firstLetter secondLetter leftLetter back hKeepLeft]
  | true =>
      cases hKeepRight : (Nat.beq rightLetter firstLetter || Nat.beq rightLetter secondLetter) with
      | false =>
          rw [mztKeepABConsKeep firstLetter secondLetter leftLetter (rightLetter :: back) hKeepLeft,
            mztKeepABConsDrop firstLetter secondLetter rightLetter back hKeepRight,
            mztKeepABConsDrop firstLetter secondLetter rightLetter (leftLetter :: back) hKeepRight,
            mztKeepABConsKeep firstLetter secondLetter leftLetter back hKeepLeft]
      | true =>
          have hEq : leftLetter = rightLetter :=
            mztKeptPairEq dependence hSym firstLetter secondLetter hDep
              leftLetter rightLetter hIndep hKeepLeft hKeepRight
          rw [hEq]

/-- Semantic soundness: trace-congruent words share every dependent-pair projection. -/
theorem mztCongrPreservesKeepAB (dependence : Nat → Nat → Bool)
    (hSym : ∀ leftValue rightValue, dependence leftValue rightValue
      = dependence rightValue leftValue)
    {left right : List Nat} (hCongr : MztTraceCongr dependence left right) :
    ∀ firstLetter secondLetter, dependence firstLetter secondLetter = true →
      mztKeepAB firstLetter secondLetter left = mztKeepAB firstLetter secondLetter right := by
  induction hCongr with
  | refl word => intro firstLetter secondLetter _; rfl
  | adjacentSwap front leftLetter rightLetter back hIndep =>
      intro firstLetter secondLetter hDep
      rw [mztKeepABAppend firstLetter secondLetter front (leftLetter :: rightLetter :: back),
        mztKeepABAppend firstLetter secondLetter front (rightLetter :: leftLetter :: back)]
      exact congrArg (fun tail => mztKeepAB firstLetter secondLetter front ++ tail)
        (mztKeepABSwapPair dependence hSym firstLetter secondLetter hDep
          leftLetter rightLetter hIndep back)
  | symm _ ih =>
      intro firstLetter secondLetter hDep
      exact (ih firstLetter secondLetter hDep).symm
  | trans _ _ ihLeft ihRight =>
      intro firstLetter secondLetter hDep
      exact Eq.trans (ihLeft firstLetter secondLetter hDep) (ihRight firstLetter secondLetter hDep)

/-! ## Completeness (Keller's theorem / Cartier-Foata) -/

/-- Stripping a common head letter from two words with equal `{firstLetter, secondLetter}`
projections leaves the tails' projections equal. -/
theorem mztKeepABConsInj (firstLetter secondLetter head : Nat) (leftTail rightTail : List Nat)
    (hEq : mztKeepAB firstLetter secondLetter (head :: leftTail)
      = mztKeepAB firstLetter secondLetter (head :: rightTail)) :
    mztKeepAB firstLetter secondLetter leftTail = mztKeepAB firstLetter secondLetter rightTail := by
  cases hKeep : (Nat.beq head firstLetter || Nat.beq head secondLetter) with
  | true =>
      rw [mztKeepABConsKeep firstLetter secondLetter head leftTail hKeep,
        mztKeepABConsKeep firstLetter secondLetter head rightTail hKeep] at hEq
      exact (List.cons.inj hEq).right
  | false =>
      rw [mztKeepABConsDrop firstLetter secondLetter head leftTail hKeep,
        mztKeepABConsDrop firstLetter secondLetter head rightTail hKeep] at hEq
      exact hEq

/-- The head-bubbling engine.  If, for every letter `x` dependent with `a`, the
`{a, x}`-projection of `currentRight` starts with `a` (equivalently equals
`a :: projection of leftRest`), then `a` occurs in `currentRight` and can be moved to the
front by adjacent-independent swaps.  The recursion peels an independent head `e`: `e` is
independent of `a` (else the `{a, e}`-projection would start with `e`), and dropping `e`
preserves every relevant projection (since `e` is independent of every `x` dependent with
`a`), so the invariant descends. -/
def mztBubbleHead (dependence : Nat → Nat → Bool)
    (hSym : ∀ leftValue rightValue, dependence leftValue rightValue
      = dependence rightValue leftValue)
    (hRefl : ∀ value, dependence value value = true)
    (headLetter : Nat) (leftRest : List Nat) :
    (currentRight : List Nat) →
    (∀ probe, dependence headLetter probe = true →
        mztKeepAB headLetter probe currentRight
          = headLetter :: mztKeepAB headLetter probe leftRest) →
    PSigma (fun post => MztTraceCongr dependence currentRight (headLetter :: post))
  | [], hHeadFact =>
      nomatch (show ([] : List Nat) = headLetter :: mztKeepAB headLetter headLetter leftRest from
        hHeadFact headLetter (hRefl headLetter))
  | firstRight :: laterRight, hHeadFact =>
      match hHeadEq : Nat.beq firstRight headLetter with
      | true =>
          ⟨laterRight, by
            have hEq : firstRight = headLetter := cswNatBeqEq firstRight headLetter hHeadEq
            rw [hEq]
            exact MztTraceCongr.refl (headLetter :: laterRight)⟩
      | false =>
          have hIndepAHead : dependence headLetter firstRight = false := by
            cases hCheck : dependence headLetter firstRight with
            | false => rfl
            | true =>
                have hProjected := hHeadFact firstRight hCheck
                rw [mztKeepABConsKeep headLetter firstRight firstRight laterRight
                  (mztKeepTestSelfRight firstRight headLetter)] at hProjected
                injection hProjected with hHead _
                rw [hHead] at hHeadEq
                rw [cswNatBeqRefl headLetter] at hHeadEq
                exact Bool.noConfusion hHeadEq
          have hHeadFactLater : ∀ probe, dependence headLetter probe = true →
              mztKeepAB headLetter probe laterRight
                = headLetter :: mztKeepAB headLetter probe leftRest := by
            intro probe hDepProbe
            have hFull := hHeadFact probe hDepProbe
            have hDrop : (Nat.beq firstRight headLetter || Nat.beq firstRight probe) = false := by
              have hProbeNe : Nat.beq firstRight probe = false := by
                cases hCheck : Nat.beq firstRight probe with
                | false => rfl
                | true =>
                    have hProbeEq : firstRight = probe := cswNatBeqEq firstRight probe hCheck
                    rw [hProbeEq] at hIndepAHead
                    rw [hDepProbe] at hIndepAHead
                    exact Bool.noConfusion hIndepAHead
              rw [hHeadEq, hProbeNe]; rfl
            rw [mztKeepABConsDrop headLetter probe firstRight laterRight hDrop] at hFull
            exact hFull
          match mztBubbleHead dependence hSym hRefl headLetter leftRest laterRight hHeadFactLater with
          | ⟨post, hCongLater⟩ =>
              ⟨firstRight :: post, by
                have hStepCons : MztTraceCongr dependence (firstRight :: laterRight)
                    (firstRight :: headLetter :: post) :=
                  mztTraceCongrCons dependence firstRight hCongLater
                have hIndepHeadA : dependence firstRight headLetter = false := by
                  rw [hSym firstRight headLetter]
                  exact hIndepAHead
                have hStepSwap : MztTraceCongr dependence (firstRight :: headLetter :: post)
                    (headLetter :: firstRight :: post) :=
                  MztTraceCongr.adjacentSwap [] firstRight headLetter post hIndepHeadA
                exact MztTraceCongr.trans hStepCons hStepSwap⟩

/-- Semantic completeness: words agreeing on every dependent-pair
projection are trace-congruent. -/
theorem mztProjAgreeComplete (dependence : Nat → Nat → Bool)
    (hSym : ∀ leftValue rightValue, dependence leftValue rightValue
      = dependence rightValue leftValue)
    (hRefl : ∀ value, dependence value value = true) :
    (left right : List Nat) →
    (∀ firstLetter secondLetter, dependence firstLetter secondLetter = true →
      mztKeepAB firstLetter secondLetter left = mztKeepAB firstLetter secondLetter right) →
    MztTraceCongr dependence left right
  | [], right, hAgree => by
      cases right with
      | nil => exact MztTraceCongr.refl []
      | cons headRight restRight =>
          have hProjected := hAgree headRight headRight (hRefl headRight)
          rw [mztKeepABConsKeep headRight headRight headRight restRight
            (mztKeepTestSelfLeft headRight headRight)] at hProjected
          exact nomatch
            (show ([] : List Nat) = headRight :: mztKeepAB headRight headRight restRight
              from hProjected)
  | headLeft :: leftRest, right, hAgree => by
      have hHeadFact : ∀ probe, dependence headLeft probe = true →
          mztKeepAB headLeft probe right
            = headLeft :: mztKeepAB headLeft probe leftRest := by
        intro probe hDepProbe
        have hEq := hAgree headLeft probe hDepProbe
        rw [mztKeepABConsKeep headLeft probe headLeft leftRest
          (mztKeepTestSelfLeft headLeft probe)] at hEq
        exact hEq.symm
      match mztBubbleHead dependence hSym hRefl headLeft leftRest right hHeadFact with
      | ⟨post, hCong⟩ =>
          have hTail : ∀ firstLetter secondLetter, dependence firstLetter secondLetter = true →
              mztKeepAB firstLetter secondLetter leftRest
                = mztKeepAB firstLetter secondLetter post := by
            intro firstLetter secondLetter hDep
            have hRightPost := mztCongrPreservesKeepAB dependence hSym hCong
              firstLetter secondLetter hDep
            have hLeftRight := hAgree firstLetter secondLetter hDep
            exact mztKeepABConsInj firstLetter secondLetter headLeft leftRest post
              (Eq.trans hLeftRight hRightPost)
          have hRec := mztProjAgreeComplete dependence hSym hRefl leftRest post hTail
          exact MztTraceCongr.trans (mztTraceCongrCons dependence headLeft hRec)
            (MztTraceCongr.symm hCong)

/-! ## The decision procedure -/

/-- Boolean membership of a letter in a word. -/
def mztMemBool (target : Nat) : List Nat → Bool
  | [] => false
  | head :: rest => Nat.beq head target || mztMemBool target rest

/-- Membership distributes over `++`. -/
theorem mztMemAppend (target : Nat) : (front tail : List Nat) →
    mztMemBool target (front ++ tail) = (mztMemBool target front || mztMemBool target tail)
  | [], _ => rfl
  | head :: rest, tail => by
      show (Nat.beq head target || mztMemBool target (rest ++ tail))
          = ((Nat.beq head target || mztMemBool target rest) || mztMemBool target tail)
      rw [mztMemAppend target rest tail]
      exact mztOrAssoc (Nat.beq head target) (mztMemBool target rest) (mztMemBool target tail)

/-- Insert a letter into the running dedup accumulator (skip if already present). -/
def mztInsertLetter (letter : Nat) (accumulator : List Nat) : List Nat :=
  cond (mztMemBool letter accumulator) accumulator (letter :: accumulator)

/-- Deduplicate a word's letters. -/
def mztDedup : List Nat → List Nat
  | [] => []
  | head :: rest => mztInsertLetter head (mztDedup rest)

/-- The inserted letter is present after insertion. -/
theorem mztMemInsertHead (letter : Nat) (accumulator : List Nat) :
    mztMemBool letter (mztInsertLetter letter accumulator) = true := by
  show mztMemBool letter (cond (mztMemBool letter accumulator) accumulator (letter :: accumulator))
      = true
  cases hMem : mztMemBool letter accumulator with
  | true => exact hMem
  | false =>
      show (Nat.beq letter letter || mztMemBool letter accumulator) = true
      rw [cswNatBeqRefl letter]; rfl

/-- Insertion preserves existing membership. -/
theorem mztMemInsertMono (target letter : Nat) (accumulator : List Nat)
    (hMem : mztMemBool target accumulator = true) :
    mztMemBool target (mztInsertLetter letter accumulator) = true := by
  show mztMemBool target (cond (mztMemBool letter accumulator) accumulator (letter :: accumulator))
      = true
  cases hInner : mztMemBool letter accumulator with
  | true => exact hMem
  | false =>
      show (Nat.beq letter target || mztMemBool target accumulator) = true
      rw [hMem]
      exact mztOrTrueRight (Nat.beq letter target)

/-- Dedup preserves membership. -/
theorem mztMemDedup (target : Nat) : (word : List Nat) →
    mztMemBool target word = true → mztMemBool target (mztDedup word) = true
  | [], hMem => hMem
  | head :: rest, hMem => by
      show mztMemBool target (mztInsertLetter head (mztDedup rest)) = true
      cases hHead : Nat.beq head target with
      | true =>
          have hEq : head = target := cswNatBeqEq head target hHead
          rw [hEq]
          exact mztMemInsertHead target (mztDedup rest)
      | false =>
          have hRest : mztMemBool target rest = true := by
            have hFull : (Nat.beq head target || mztMemBool target rest) = true := hMem
            rw [hHead] at hFull
            exact hFull
          exact mztMemInsertMono target head (mztDedup rest) (mztMemDedup target rest hRest)

/-! ### The pair carrier -/

/-- Boolean membership of an ordered pair in a pair list. -/
def mztPairMemBool (firstLetter secondLetter : Nat) : List (Nat × Nat) → Bool
  | [] => false
  | (leftEntry, rightEntry) :: rest =>
      (Nat.beq leftEntry firstLetter && Nat.beq rightEntry secondLetter)
        || mztPairMemBool firstLetter secondLetter rest

/-- Pair membership distributes over `++`. -/
theorem mztPairMemAppend (firstLetter secondLetter : Nat) :
    (front tail : List (Nat × Nat)) →
    mztPairMemBool firstLetter secondLetter (front ++ tail)
      = (mztPairMemBool firstLetter secondLetter front
          || mztPairMemBool firstLetter secondLetter tail)
  | [], _ => rfl
  | (leftEntry, rightEntry) :: rest, tail => by
      show ((Nat.beq leftEntry firstLetter && Nat.beq rightEntry secondLetter)
            || mztPairMemBool firstLetter secondLetter (rest ++ tail))
          = (((Nat.beq leftEntry firstLetter && Nat.beq rightEntry secondLetter)
            || mztPairMemBool firstLetter secondLetter rest)
            || mztPairMemBool firstLetter secondLetter tail)
      rw [mztPairMemAppend firstLetter secondLetter rest tail]
      exact mztOrAssoc _ _ _

/-- Pair a fixed left letter with every letter of a word. -/
def mztPairWith (fixedLetter : Nat) : List Nat → List (Nat × Nat)
  | [] => []
  | head :: rest => (fixedLetter, head) :: mztPairWith fixedLetter rest

/-- `(fixedLetter, target)` occurs in `mztPairWith fixedLetter full` when `target` occurs
in `full`. -/
theorem mztPairWithMem (fixedLetter target : Nat) : (full : List Nat) →
    mztMemBool target full = true →
    mztPairMemBool fixedLetter target (mztPairWith fixedLetter full) = true
  | [], hMem => hMem
  | head :: rest, hMem => by
      show ((Nat.beq fixedLetter fixedLetter && Nat.beq head target)
          || mztPairMemBool fixedLetter target (mztPairWith fixedLetter rest)) = true
      cases hHead : Nat.beq head target with
      | true => rw [cswNatBeqRefl fixedLetter]; rfl
      | false =>
          have hRest : mztMemBool target rest = true := by
            have hFull : (Nat.beq head target || mztMemBool target rest) = true := hMem
            rw [hHead] at hFull
            exact hFull
          rw [mztPairWithMem fixedLetter target rest hRest]
          exact mztOrTrueRight _

/-- All ordered pairs of letters drawn (left) from `rows` and (right) from `full`. -/
def mztAllPairsFrom (full : List Nat) : List Nat → List (Nat × Nat)
  | [] => []
  | head :: rest => mztPairWith head full ++ mztAllPairsFrom full rest

/-- `(firstLetter, secondLetter)` occurs in `mztAllPairsFrom full rows` when `firstLetter`
occurs in `rows` and `secondLetter` occurs in `full`. -/
theorem mztAllPairsFromMem (firstLetter secondLetter : Nat) (full : List Nat)
    (hSecond : mztMemBool secondLetter full = true) :
    (rows : List Nat) → mztMemBool firstLetter rows = true →
    mztPairMemBool firstLetter secondLetter (mztAllPairsFrom full rows) = true
  | [], hFirst => hFirst
  | head :: rest, hFirst => by
      show mztPairMemBool firstLetter secondLetter
          (mztPairWith head full ++ mztAllPairsFrom full rest) = true
      rw [mztPairMemAppend firstLetter secondLetter (mztPairWith head full)
        (mztAllPairsFrom full rest)]
      cases hHead : Nat.beq head firstLetter with
      | true =>
          have hEq : head = firstLetter := cswNatBeqEq head firstLetter hHead
          rw [hEq]
          rw [mztPairWithMem firstLetter secondLetter full hSecond]; rfl
      | false =>
          have hRest : mztMemBool firstLetter rest = true := by
            have hFull : (Nat.beq head firstLetter || mztMemBool firstLetter rest) = true := hFirst
            rw [hHead] at hFull
            exact hFull
          rw [mztAllPairsFromMem firstLetter secondLetter full hSecond rest hRest]
          exact mztOrTrueRight _

/-- The finite carrier: all ordered pairs of letters occurring in a word. -/
def mztAllPairs (letters : List Nat) : List (Nat × Nat) := mztAllPairsFrom letters letters

/-- Any pair of occurring letters is in the carrier. -/
theorem mztAllPairsMem (firstLetter secondLetter : Nat) (letters : List Nat)
    (hFirst : mztMemBool firstLetter letters = true)
    (hSecond : mztMemBool secondLetter letters = true) :
    mztPairMemBool firstLetter secondLetter (mztAllPairs letters) = true :=
  mztAllPairsFromMem firstLetter secondLetter letters hSecond letters hFirst

/-- Per-pair check: if the pair is dependent, the projections must be equal. -/
def mztPairCheckAB (dependence : Nat → Nat → Bool) (left right : List Nat)
    (firstLetter secondLetter : Nat) : Bool :=
  cond (dependence firstLetter secondLetter)
    (cswListNatBeq (mztKeepAB firstLetter secondLetter left)
      (mztKeepAB firstLetter secondLetter right))
    true

/-- All pairs in a list pass the per-pair check. -/
def mztAllPairsAgree (dependence : Nat → Nat → Bool) (left right : List Nat) :
    List (Nat × Nat) → Bool
  | [] => true
  | pair :: rest =>
      mztPairCheckAB dependence left right pair.1 pair.2
        && mztAllPairsAgree dependence left right rest

/-- The trace word decision.  Over the finite carrier of pairs occurring in the two
words, every dependent pair's projections agree. -/
def mztDecideTraceEqBool (dependence : Nat → Nat → Bool) (left right : List Nat) : Bool :=
  mztAllPairsAgree dependence left right (mztAllPairs (mztDedup (left ++ right)))

/-- If the words share every dependent-pair projection, every carrier pair passes. -/
theorem mztAllPairsAgreeOfSemantic (dependence : Nat → Nat → Bool) (left right : List Nat)
    (hSemantic : ∀ firstLetter secondLetter, dependence firstLetter secondLetter = true →
      mztKeepAB firstLetter secondLetter left = mztKeepAB firstLetter secondLetter right) :
    (pairs : List (Nat × Nat)) → mztAllPairsAgree dependence left right pairs = true
  | [] => rfl
  | pair :: rest => by
      show (mztPairCheckAB dependence left right pair.1 pair.2
          && mztAllPairsAgree dependence left right rest) = true
      have hHead : mztPairCheckAB dependence left right pair.1 pair.2 = true := by
        show (cond (dependence pair.1 pair.2)
            (cswListNatBeq (mztKeepAB pair.1 pair.2 left) (mztKeepAB pair.1 pair.2 right)) true)
            = true
        cases hDep : dependence pair.1 pair.2 with
        | false => rfl
        | true =>
            have hEq : mztKeepAB pair.1 pair.2 left = mztKeepAB pair.1 pair.2 right :=
              hSemantic pair.1 pair.2 hDep
            rw [hEq]
            exact cswListNatBeqRefl (mztKeepAB pair.1 pair.2 right)
      rw [hHead]
      exact mztAllPairsAgreeOfSemantic dependence left right hSemantic rest

/-- Soundness: a trace-congruent pair is accepted. -/
theorem mztDecideSoundOfCongr (dependence : Nat → Nat → Bool)
    (hSym : ∀ leftValue rightValue, dependence leftValue rightValue
      = dependence rightValue leftValue)
    {left right : List Nat} (hCongr : MztTraceCongr dependence left right) :
    mztDecideTraceEqBool dependence left right = true :=
  mztAllPairsAgreeOfSemantic dependence left right
    (mztCongrPreservesKeepAB dependence hSym hCongr)
    (mztAllPairs (mztDedup (left ++ right)))

/-! ### The Boolean bridge — from acceptance to universal projection agreement -/

/-- Extract a single dependent pair's projection equality from an accepting run. -/
theorem mztAllPairsAgreeExtract (dependence : Nat → Nat → Bool) (left right : List Nat) :
    (pairs : List (Nat × Nat)) →
    mztAllPairsAgree dependence left right pairs = true →
    (firstLetter secondLetter : Nat) →
    mztPairMemBool firstLetter secondLetter pairs = true →
    dependence firstLetter secondLetter = true →
    mztKeepAB firstLetter secondLetter left = mztKeepAB firstLetter secondLetter right
  | [], _, _, _, hPairMem, _ => Bool.noConfusion hPairMem
  | (leftEntry, rightEntry) :: rest, hAgree, firstLetter, secondLetter, hPairMem, hDep => by
      have hSplit := cswBoolAndElim _ _ hAgree
      cases hEntry : (Nat.beq leftEntry firstLetter && Nat.beq rightEntry secondLetter) with
      | true =>
          have hEntrySplit := cswBoolAndElim _ _ hEntry
          have hLeftEq : leftEntry = firstLetter := cswNatBeqEq leftEntry firstLetter hEntrySplit.left
          have hRightEq : rightEntry = secondLetter :=
            cswNatBeqEq rightEntry secondLetter hEntrySplit.right
          have hCheck : mztPairCheckAB dependence left right leftEntry rightEntry = true :=
            hSplit.left
          rw [hLeftEq, hRightEq] at hCheck
          have hCond : cond (dependence firstLetter secondLetter)
              (cswListNatBeq (mztKeepAB firstLetter secondLetter left)
                (mztKeepAB firstLetter secondLetter right)) true = true := hCheck
          rw [hDep] at hCond
          exact cswListNatBeqEq _ _ hCond
      | false =>
          have hUnfold : ((Nat.beq leftEntry firstLetter && Nat.beq rightEntry secondLetter)
              || mztPairMemBool firstLetter secondLetter rest) = true := hPairMem
          rw [hEntry] at hUnfold
          exact mztAllPairsAgreeExtract dependence left right rest hSplit.right
            firstLetter secondLetter hUnfold hDep

/-- A letter absent from a word: its `{a, b}`-projection collapses to the `{b, b}` one. -/
theorem mztKeepABReduceFirst (firstLetter secondLetter : Nat) : (word : List Nat) →
    mztMemBool firstLetter word = false →
    mztKeepAB firstLetter secondLetter word = mztKeepAB secondLetter secondLetter word
  | [], _ => rfl
  | head :: rest, hMem => by
      have hSplit := mztOrFalseElim _ _ hMem
      have hHeadFirst : Nat.beq head firstLetter = false := hSplit.left
      have hRest : mztMemBool firstLetter rest = false := hSplit.right
      cases hHeadSecond : Nat.beq head secondLetter with
      | true =>
          rw [mztKeepABConsKeep firstLetter secondLetter head rest
              (by rw [hHeadFirst, hHeadSecond]; rfl),
            mztKeepABConsKeep secondLetter secondLetter head rest (by rw [hHeadSecond]; rfl),
            mztKeepABReduceFirst firstLetter secondLetter rest hRest]
      | false =>
          rw [mztKeepABConsDrop firstLetter secondLetter head rest
              (by rw [hHeadFirst, hHeadSecond]; rfl),
            mztKeepABConsDrop secondLetter secondLetter head rest (by rw [hHeadSecond]; rfl)]
          exact mztKeepABReduceFirst firstLetter secondLetter rest hRest

/-- A letter absent from a word: its `{a, b}`-projection collapses to the `{a, a}` one. -/
theorem mztKeepABReduceSecond (firstLetter secondLetter : Nat) : (word : List Nat) →
    mztMemBool secondLetter word = false →
    mztKeepAB firstLetter secondLetter word = mztKeepAB firstLetter firstLetter word
  | [], _ => rfl
  | head :: rest, hMem => by
      have hSplit := mztOrFalseElim _ _ hMem
      have hHeadSecond : Nat.beq head secondLetter = false := hSplit.left
      have hRest : mztMemBool secondLetter rest = false := hSplit.right
      cases hHeadFirst : Nat.beq head firstLetter with
      | true =>
          rw [mztKeepABConsKeep firstLetter secondLetter head rest (by rw [hHeadFirst]; rfl),
            mztKeepABConsKeep firstLetter firstLetter head rest (by rw [hHeadFirst]; rfl),
            mztKeepABReduceSecond firstLetter secondLetter rest hRest]
      | false =>
          rw [mztKeepABConsDrop firstLetter secondLetter head rest
              (by rw [hHeadFirst, hHeadSecond]; rfl),
            mztKeepABConsDrop firstLetter firstLetter head rest (by rw [hHeadFirst]; rfl)]
          exact mztKeepABReduceSecond firstLetter secondLetter rest hRest

/-- A diagonal projection onto an absent letter is empty. -/
theorem mztKeepABEmptyOfAbsent (letter : Nat) : (word : List Nat) →
    mztMemBool letter word = false → mztKeepAB letter letter word = []
  | [], _ => rfl
  | head :: rest, hMem => by
      have hSplit := mztOrFalseElim _ _ hMem
      have hHead : Nat.beq head letter = false := hSplit.left
      have hRest : mztMemBool letter rest = false := hSplit.right
      rw [mztKeepABConsDrop letter letter head rest (by rw [hHead]; rfl)]
      exact mztKeepABEmptyOfAbsent letter rest hRest

/-- The bridge: acceptance yields universal dependent-pair projection agreement. -/
theorem mztDecideToProjAgree (dependence : Nat → Nat → Bool)
    (hRefl : ∀ value, dependence value value = true)
    {left right : List Nat}
    (hDecide : mztDecideTraceEqBool dependence left right = true) :
    ∀ firstLetter secondLetter, dependence firstLetter secondLetter = true →
      mztKeepAB firstLetter secondLetter left = mztKeepAB firstLetter secondLetter right := by
  intro firstLetter secondLetter hDep
  have hAgreeList : mztAllPairsAgree dependence left right
      (mztAllPairs (mztDedup (left ++ right))) = true := hDecide
  cases hFirstMem : mztMemBool firstLetter (left ++ right) with
  | true =>
      cases hSecondMem : mztMemBool secondLetter (left ++ right) with
      | true =>
          have hFirstDedup : mztMemBool firstLetter (mztDedup (left ++ right)) = true :=
            mztMemDedup firstLetter (left ++ right) hFirstMem
          have hSecondDedup : mztMemBool secondLetter (mztDedup (left ++ right)) = true :=
            mztMemDedup secondLetter (left ++ right) hSecondMem
          exact mztAllPairsAgreeExtract dependence left right
            (mztAllPairs (mztDedup (left ++ right))) hAgreeList firstLetter secondLetter
            (mztAllPairsMem firstLetter secondLetter (mztDedup (left ++ right))
              hFirstDedup hSecondDedup) hDep
      | false =>
          have hSplit := mztOrFalseElim _ _
            (show (mztMemBool secondLetter left || mztMemBool secondLetter right) = false by
              rw [← mztMemAppend secondLetter left right]; exact hSecondMem)
          rw [mztKeepABReduceSecond firstLetter secondLetter left hSplit.left,
            mztKeepABReduceSecond firstLetter secondLetter right hSplit.right]
          have hFirstDedup : mztMemBool firstLetter (mztDedup (left ++ right)) = true :=
            mztMemDedup firstLetter (left ++ right) hFirstMem
          exact mztAllPairsAgreeExtract dependence left right
            (mztAllPairs (mztDedup (left ++ right))) hAgreeList firstLetter firstLetter
            (mztAllPairsMem firstLetter firstLetter (mztDedup (left ++ right))
              hFirstDedup hFirstDedup) (hRefl firstLetter)
  | false =>
      have hSplitFirst := mztOrFalseElim _ _
        (show (mztMemBool firstLetter left || mztMemBool firstLetter right) = false by
          rw [← mztMemAppend firstLetter left right]; exact hFirstMem)
      rw [mztKeepABReduceFirst firstLetter secondLetter left hSplitFirst.left,
        mztKeepABReduceFirst firstLetter secondLetter right hSplitFirst.right]
      cases hSecondMem : mztMemBool secondLetter (left ++ right) with
      | true =>
          have hSecondDedup : mztMemBool secondLetter (mztDedup (left ++ right)) = true :=
            mztMemDedup secondLetter (left ++ right) hSecondMem
          exact mztAllPairsAgreeExtract dependence left right
            (mztAllPairs (mztDedup (left ++ right))) hAgreeList secondLetter secondLetter
            (mztAllPairsMem secondLetter secondLetter (mztDedup (left ++ right))
              hSecondDedup hSecondDedup) (hRefl secondLetter)
      | false =>
          have hSplitSecond := mztOrFalseElim _ _
            (show (mztMemBool secondLetter left || mztMemBool secondLetter right) = false by
              rw [← mztMemAppend secondLetter left right]; exact hSecondMem)
          rw [mztKeepABEmptyOfAbsent secondLetter left hSplitSecond.left,
            mztKeepABEmptyOfAbsent secondLetter right hSplitSecond.right]

/-- Completeness (Boolean form): an accepted pair is trace-congruent. -/
theorem mztDecideCompleteOfDecide (dependence : Nat → Nat → Bool)
    (hSym : ∀ leftValue rightValue, dependence leftValue rightValue
      = dependence rightValue leftValue)
    (hRefl : ∀ value, dependence value value = true)
    {left right : List Nat}
    (hDecide : mztDecideTraceEqBool dependence left right = true) :
    MztTraceCongr dependence left right :=
  mztProjAgreeComplete dependence hSym hRefl left right
    (mztDecideToProjAgree dependence hRefl hDecide)

/-- The trace word problem is decided. -/
theorem mztTraceDecisionCorrect (dependence : Nat → Nat → Bool)
    (hSym : ∀ leftValue rightValue, dependence leftValue rightValue
      = dependence rightValue leftValue)
    (hRefl : ∀ value, dependence value value = true)
    (left right : List Nat) :
    mztDecideTraceEqBool dependence left right = true ↔ MztTraceCongr dependence left right :=
  Iff.intro (mztDecideCompleteOfDecide dependence hSym hRefl)
    (mztDecideSoundOfCongr dependence hSym)

/-! ## Capability marker -/

/-- The Mazurkiewicz-trace word problem is fully decided: the trace congruence,
the projection-based decision, and its soundness-and-completeness (Keller's theorem)
all hold as zero-axiom structural results. -/
def mztHasTraceWordProblemDecided : Bool := true

/-! ## Ground fires -/

/-- Independent letters commute: with equality-dependence (the free commutative monoid),
`[x, y]` and `[y, x]` decide equivalent. -/
theorem mztFireIndependentSwapTrue :
    mztDecideTraceEqBool (fun leftValue rightValue => Nat.beq leftValue rightValue) [0, 1] [1, 0]
      = true := rfl

/-- Dependent letters do not commute: with full dependence (the free monoid), `[x, y]`
and `[y, x]` decide inequivalent. -/
theorem mztFireDependentSwapFalse :
    mztDecideTraceEqBool (fun _ _ => true) [0, 1] [1, 0] = false := rfl

/-- A three-letter trace-equivalent pair: `0`-`1` dependent, everything else independent;
swapping the independent `1`,`2` keeps equivalence. -/
theorem mztFireThreeLetterTrue :
    mztDecideTraceEqBool
      (fun leftValue rightValue => Nat.beq leftValue rightValue
        || (Nat.beq leftValue 0 && Nat.beq rightValue 1)
        || (Nat.beq leftValue 1 && Nat.beq rightValue 0))
      [0, 1, 2] [0, 2, 1] = true := rfl

/-- Control: with `0`-`1` dependent, `[0, 1]` and `[1, 0]` decide inequivalent. -/
theorem mztFireControlFalse :
    mztDecideTraceEqBool
      (fun leftValue rightValue => Nat.beq leftValue rightValue
        || (Nat.beq leftValue 0 && Nat.beq rightValue 1)
        || (Nat.beq leftValue 1 && Nat.beq rightValue 0))
      [0, 1] [1, 0] = false := rfl

end FX1Poly.ComputerAlgebra

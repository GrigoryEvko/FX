import FX1Poly.OmegacE.OmegacEAt

/-! # FX1Poly/OmegacE/OmegacEFiniteType
    — the ωcE polygraph is a BINARY FINITE-TYPE family (SN-122 core, #625)

The walking-coherent-equivalence generator family `OmegacECell` (`OmegacEAt.lean`, HLOR Construction 1.22) is
**finite-type**: at every dimension there are finitely many — in fact exactly two — generating cells, and they
are exhaustively enumerated.  This is the finite-type-family property Makkai's ωcE classifier rests on (the
word-problem search space at each dimension is finite), supplied here as a standalone theorem.

* `generatorsAt dimension` — the complete generator list at each dimension (0: the two vertices; 1:
  quasiIso/quasiInverse; 2: alphaUnit/betaCounit; k+3: the two higher-coherence cells).  A plain structural
  match on the Nat dimension (the partition `0 | 1 | 2 | baseDim+3` is exhaustive over ℕ).
* `generatorsAt_length` — exactly two generators at every dimension (binary finite-type).
* `mem_generatorsAt` — EXHAUSTIVENESS: every cell appears in `generatorsAt`.  Indexed `OmegacECell.casesOn`
  with the membership motive; the higher-coherence arm splits the `Fin 2` index by direct structure matching
  (`⟨0,_⟩ / ⟨1,_⟩ / ⟨v+2, h⟩`), discharging the out-of-range case by `Nat.not_lt`+`Nat.le_add_left`
  (propext-free, avoiding the `Fin.cases` axiom leak).

## Honest scope / ledger

This ships the finite-type ENUMERATION + exhaustiveness — a genuine, standalone ωcE structural theorem.  It does
NOT bump `fxOmegacEConstructionLevel`: the linear `OmegacEConstructionLevel` ladder places `finiteTypeFamily`
above `boundaryPresented`/`hlorPushoutConstruction`, and those rungs (the generator BOUNDARY data + the HLOR
pushout) remain the deferred Axis-9 construction.  The enumeration here is independent of those rungs and stands
on its own.  Deferred enrichments: per-dimension distinctness (`generatorsAt` is `Nodup` — exactly two DISTINCT
generators), and compatibility with the suspension `Σ` (the "+ Suspend" half of SN-122).

## Zero-axiom verification

The Nat-indexed `generatorsAt` (a structural ℕ match) and `generatorsAt_length` (`rfl` per case) are immediate.
`mem_generatorsAt` is a single `OmegacECell.casesOn` into membership proofs, with `Fin 2` split by structure
(no `Fin.cases`/`Fin` `OfNat` numerals).  No `axiom`, `sorry`, `propext`, `Quot.sound`, `Classical`,
`native_decide`, `omega`.  Per-declaration gated in `FX1PolyAudit/AuditOmegacE.lean`.
-/

namespace FX1Poly.OmegacE

/-- The complete list of ωcE generators at each dimension: exactly two per dimension (0: the two vertices;
1: quasiIso/quasiInverse; 2: alpha/beta; k+3: the two higher-coherence cells). -/
def generatorsAt : (dimension : Nat) → List (OmegacECell dimension)
  | 0 => [OmegacECell.sourceVertex, OmegacECell.targetVertex]
  | 1 => [OmegacECell.quasiIso, OmegacECell.quasiInverse]
  | 2 => [OmegacECell.alphaUnit, OmegacECell.betaCounit]
  | (baseDim + 3) =>
      [OmegacECell.higherCoherence baseDim ⟨0, by decide⟩,
       OmegacECell.higherCoherence baseDim ⟨1, by decide⟩]

/-- The ωcE polygraph is **binary finite-type**: exactly two generators at every dimension. -/
theorem generatorsAt_length (dimension : Nat) : (generatorsAt dimension).length = 2 := by
  match dimension with
  | 0 => rfl
  | 1 => rfl
  | 2 => rfl
  | (_ + 3) => rfl

/-- Membership helper: the second element of a two-element list. -/
private theorem mem_pair_second {carrier : Type} (first second : carrier) :
    second ∈ [first, second] :=
  List.Mem.tail first (List.Mem.head [])

/-- **Exhaustiveness**: every ωcE generator appears in `generatorsAt`.  With `generatorsAt_length` this is the
finite-type-family witness — the polygraph is generated by a finite (binary) family at each dimension,
exhaustively enumerated.  Indexed `casesOn` with the membership motive; the higher-coherence arm splits the
`Fin 2` slot by direct structure matching (propext-free, avoiding `Fin.cases`). -/
theorem mem_generatorsAt {dimension : Nat} (cell : OmegacECell dimension) :
    cell ∈ generatorsAt dimension :=
  OmegacECell.casesOn
    (motive := fun dim candidate => candidate ∈ generatorsAt dim)
    cell
    (List.Mem.head [OmegacECell.targetVertex])
    (mem_pair_second OmegacECell.sourceVertex OmegacECell.targetVertex)
    (List.Mem.head [OmegacECell.quasiInverse])
    (mem_pair_second OmegacECell.quasiIso OmegacECell.quasiInverse)
    (List.Mem.head [OmegacECell.betaCounit])
    (mem_pair_second OmegacECell.alphaUnit OmegacECell.betaCounit)
    (fun _baseDim cellIndex =>
      match cellIndex with
      | ⟨0, _⟩ => List.Mem.head _
      | ⟨1, _⟩ => mem_pair_second _ _
      | ⟨counterValue + 2, isLessThanTwo⟩ =>
          absurd isLessThanTwo (Nat.not_lt.mpr (Nat.le_add_left 2 counterValue)))

end FX1Poly.OmegacE

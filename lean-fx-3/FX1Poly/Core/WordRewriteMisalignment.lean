import FX1Poly.Core.StepWordRewriteSoundness
import FX1Poly.Core.StepRewriteRuleMap
import FX1Poly.Core.RawTermNF

/-! # FX1Poly/Core/WordRewriteMisalignment
   — the full word system fires on the image of a Step-normal form (the SN-134 verdict)

The Leg-3 roadmap's word-problem decision (`decidableConvertibleModulo_ofConvergent` over a
`WordReducer fxStepSystem`) presupposes that word rewriting under the generated system tracks
term rewriting.  This module REFUTES that presupposition outright, completing the honest
closure of the full-system route whose termination half was already refuted
(`untypedWordReductionDiverges`, SN-131):

  * **The misalignment.**  `RawTerm.toCode` serializes a term as its preorder
    `[tag, payload]` pairs.  Word rewriting (`FxWordRewritesOneStep`) fires a rule wherever
    its left-hand-side word occurs — including at an ODD offset, where the rule's tags land
    on the host's PAYLOAD slots and vice versa.  Since `gen_var.toNat = 0` and every
    non-variable node of the beta-redex `app(lam(unit, var 0), unit)` carries payload `0`,
    that redex's code `[3,0,2,0,1,0,0,0,1,0]` reads, at odd offset, as five consecutive
    VARIABLE leaves with payloads `3, 2, 1, 0, 1` — and a left-nested chain of pairs of
    variables exhibits exactly that slice.
  * **`fxWordRewritesOneStep_firesOnNormalImage`** — the word system rewrites the code of
    `misalignedPairHost`, a term that is a `Step`-NORMAL FORM (nested pairs of variables:
    no beta, no iota, no congruence target).
  * **`wordStepInversion_isFalse`** — hence the word→term inversion ("every word rewrite of
    an encoded term reflects to a `Step` of the term") is FALSE — even in the weak form that
    asks only for SOME term reduct.  Word rewriting under `fxStepSystem` is STRICTLY COARSER
    than term rewriting.

## What this closes and what remains

Together with `untypedWordReductionDiverges`, BOTH hypotheses of the convergent-presentation
decision are unsatisfiable for the FULL `fxStepSystem`: it does not terminate, and its
rewriting does not even simulate term reduction backward, so no sound+complete
`WordReducer`-style engine can decide term conversion through it.  The honest Leg-3 word
decisions remain the CERTIFIED-IMAGE reflections (`certifiedWordConfluence`,
`typedRootWordReductionTerminates`) and the cross-leg identification of the Leg-3 decision
with the Path-A decidable Conv (SN-138).  An ALIGNED word reducer — one that first decodes
the word on the rigid fragment (the shipped `.fx0c` parser) and fires only at decoded subterm
boundaries — is the recorded follow-on; this module is the proof that the decode step is
NECESSARY, not an optimization.

## Zero-axiom verification

Concrete cell constructions, `rfl` code computations, one `decide` on the closed normal-form
Boolean, and the three `FxWordRewritesOneStep` constructors.  No `axiom`, `sorry`, `propext`,
`Quot.sound`, `Classical`, `native_decide`, `omega`.  Gated in
`FX1PolyAudit/AuditCore.lean`'s shard family.
-/

namespace FX1Poly.Core

/-- The unit value cell (scope-polymorphic leaf). -/
def misalignmentUnitLeaf {scope : Nat} : RawTerm scope :=
  .mkGen .gen_unit () .childNil

/-- **The misalignment beta-redex** `app(lam(unit, var 0), unit)` at scope `0`: every
non-variable node carries payload `0`, so its code's odd-offset reading consists entirely of
variable tags. -/
def misalignmentRedex : RawTerm 0 :=
  .mkGen .gen_app ()
    (.childCons
      (.mkGen .gen_lam ()
        (.childCons misalignmentUnitLeaf
          (.childCons (.mkGen .gen_var ⟨0, Nat.zero_lt_one⟩ .childNil) .childNil)))
      (.childCons misalignmentUnitLeaf .childNil))

/-- The redex genuinely reduces: `Step.beta`, contracting to `subst0 (var 0) unit`, which is
definitionally the unit leaf (innermost-variable substitution computes). -/
theorem misalignmentRedex_steps :
    Step misalignmentRedex (misalignmentUnitLeaf : RawTerm 0) :=
  Step.beta

/-- **The induced rewrite rule, with both sides as literal words.**  The left side is the
redex's code, the right side the contractum's; both equations are `rfl` over the shipped
serializer. -/
def misalignmentRule : FxTermRewriteRule where
  leftHandSide := [3, 0, 2, 0, 1, 0, 0, 0, 1, 0]
  rightHandSide := [1, 0]

/-- The literal rule is generated by the system: its sides are the codes of an actual
reduction's endpoints. -/
theorem misalignmentRule_mem_fxStepSystem : fxStepSystem misalignmentRule :=
  ⟨0, misalignmentRedex, misalignmentUnitLeaf, misalignmentRedex_steps, rfl, rfl⟩

/-- A variable leaf of the four-variable scope hosting the misaligned occurrence. -/
def misalignedVarLeaf (index : Nat) (isInScope : index < 4) : RawTerm 4 :=
  .mkGen .gen_var ⟨index, isInScope⟩ .childNil

/-- A pair cell over the hosting scope. -/
def misalignedPairCell (leftComponent rightComponent : RawTerm 4) : RawTerm 4 :=
  .mkGen .gen_pair () (.childCons leftComponent (.childCons rightComponent .childNil))

/-- **The misaligned host**: a left-nested chain of pairs whose six variable leaves carry
indices `3, 2, 1, 0, 1, 0` — chosen so the redex code `[3,0,2,0,1,0,0,0,1,0]` occurs in the
host's code at an ODD offset (starting at the first leaf's payload slot).  Pairs of
variables admit no reduction: the host is a `Step`-normal form. -/
def misalignedPairHost : RawTerm 4 :=
  misalignedPairCell
    (misalignedPairCell
      (misalignedPairCell
        (misalignedPairCell
          (misalignedPairCell
            (misalignedVarLeaf 3 (by decide))
            (misalignedVarLeaf 2 (by decide)))
          (misalignedVarLeaf 1 (by decide)))
        (misalignedVarLeaf 0 (by decide)))
      (misalignedVarLeaf 1 (by decide)))
    (misalignedVarLeaf 0 (by decide))

/-- The host is a `Step`-normal form (the computable normal-form Boolean evaluates). -/
theorem misalignedPairHost_isNormal : RawTerm.isStepNormalForm misalignedPairHost := by
  decide

/-- **The misaligned slice equation**: the host's code is the redex code flanked by a prefix
of pair tags (plus the first leaf's tag) and the last leaf's payload — with the rule's words
landing at an odd offset.  Pure serializer computation. -/
theorem misalignedPairHost_code :
    misalignedPairHost.toCode
      = [4, 0, 4, 0, 4, 0, 4, 0, 4, 0, 0]
          ++ ([3, 0, 2, 0, 1, 0, 0, 0, 1, 0] ++ [0]) := rfl

/-- ★ **The full word system rewrites the image of a normal form.**  The misaligned
occurrence fires (`fire` under the left/right word contexts), although the host term admits
NO `Step`.  Word rewriting under the generated system is strictly coarser than term
rewriting. -/
theorem fxWordRewritesOneStep_firesOnNormalImage :
    ∃ rewrittenWord : List Nat,
      FxWordRewritesOneStep fxStepSystem misalignedPairHost.toCode rewrittenWord := by
  refine ⟨[4, 0, 4, 0, 4, 0, 4, 0, 4, 0, 0] ++ ([1, 0] ++ [0]), ?_⟩
  rw [misalignedPairHost_code]
  exact FxWordRewritesOneStep.underLeftContext _
    (FxWordRewritesOneStep.underRightContext _
      (FxWordRewritesOneStep.fire misalignmentRule misalignmentRule_mem_fxStepSystem))

/-- ★ **The word→term inversion is FALSE** — even in the weak form asking only for SOME term
reduct: the misaligned host's code rewrites, but the host is a normal form.  This is the
formal verdict on the full-system `WordReducer` route: together with the shipped
non-termination (`untypedWordReductionDiverges`), both hypotheses of the
convergent-presentation decision fail for `fxStepSystem`, and an honest word-layer decision
must decode to the term layer first. -/
theorem wordStepInversion_isFalse :
    ¬ (∀ (scope : Nat) (source : RawTerm scope) (rewrittenWord : List Nat),
        FxWordRewritesOneStep fxStepSystem source.toCode rewrittenWord →
          ∃ reduct : RawTerm scope, Step source reduct) := by
  intro inversion
  obtain ⟨rewrittenWord, fires⟩ := fxWordRewritesOneStep_firesOnNormalImage
  obtain ⟨reduct, steps⟩ := inversion 4 misalignedPairHost rewrittenWord fires
  exact RawTerm.isStepNormalForm_blocks_step misalignedPairHost_isNormal reduct steps

end FX1Poly.Core

import FX1Poly.Core.Rewriting.Confluence.Newman

/-! # Core/Rewriting/Confluence — Knuth-Bendix: the convergence criterion + orientation soundness

Knuth-Bendix completion turns a set of equations `E` into a CONVERGENT (confluent + terminating) rewrite
system that DECIDES the equational theory `⟷*_E`.  The completion PROCEDURE (orient / deduce critical
pairs / simplify, looping to a fixpoint, with the Bachmair-Dershowitz fairness-correctness theorem) and the
term-level critical-pair COMPUTATION are not built here — the FX rule bundle is designed orthogonal
(`fxRewriteBundle_rowsDisjoint = true`), so it has no critical pairs and needs no completion.  What this
file ships is the abstract mathematical CORE that justifies completion, over an arbitrary relation:

  * **`EquationalTheory rel`** — the theory `⟷*` generated by a system: the equivalence closure (forward
    and backward steps, reflexive and transitive).
  * **`churchRosser_of_confluent`** — THE Church-Rosser theorem: for a CONFLUENT relation, `⟷*` is exactly
    JOINABILITY `↓` (convertible iff a common reduct exists).  This is why a confluent system's theory is
    decided by reduction: `a ⟷* b ↔ a↓ = b↓`.
  * **`knuthBendixConvergenceCriterion`** — the KB criterion: a TERMINATING, LOCALLY CONFLUENT system (all
    critical pairs joinable ⟹ weakly confluent) has `⟷* = ↓` — it decides its theory.  Composes Newman
    (`terminating + weakly confluent ⟹ confluent`) with Church-Rosser.
  * **`equationalTheory_orientationInvariant`** — completion SOUNDNESS: orienting an equation (choosing a
    rule direction) does NOT change the theory, because `⟷*` is direction-blind (the equivalence closure of
    a relation equals that of its symmetrization).
  * **`oneRuleConvergent`** — a concrete non-vacuous witness: the single-rule system `{true ↦ false}` is
    terminating + locally confluent, so its theory `true ⟷ false` is decided by joinability.

## Honest scope

Abstract criterion + soundness only.  The completion ALGORITHM (the orient/deduce loop), its fairness and
partial-correctness (a fair run yields a convergent, theory-equivalent system), and the failure/divergence
modes (an unorientable equation; non-termination of the loop) are deferred.  The FX system is orthogonal, so
its confluence comes from the diamond / parallel-reduction route (`StepStar.rawConfluence`, no termination),
not from Newman — completion is simply not on its critical path.

## Zero-axiom verification

Inductions on the `EquationalTheory` / `ReflTransClosure` inductive `Prop`s (free-variable indices, so
propext-clean), `Confluent` at the `trans` case, `newman` for the criterion, `Acc` for the witness's
termination.  No `axiom`, `sorry`, `propext`, `Quot.sound`, `Classical`, `native_decide`, `omega`.
Per-declaration gated in `FX1PolyAudit/AuditCoreTerminationOrders.lean`.
-/

namespace FX1Poly.Core

universe carrierUniverse
variable {Carrier : Type carrierUniverse}

/-- The **equational theory** generated by a rewrite system — the symmetric-reflexive-transitive (i.e.
equivalence) closure `⟷*` of `rel`.  Two terms are convertible when joined by a finite chain of forward and
backward `rel`-steps. -/
inductive EquationalTheory (rel : Carrier → Carrier → Prop) : Carrier → Carrier → Prop where
  /-- A single forward step is a conversion. -/
  | rule {source target : Carrier} (step : rel source target) : EquationalTheory rel source target
  /-- Reflexivity. -/
  | refl (point : Carrier) : EquationalTheory rel point point
  /-- Symmetry (backward steps). -/
  | symm {left right : Carrier} (conv : EquationalTheory rel left right) : EquationalTheory rel right left
  /-- Transitivity (chaining). -/
  | trans {left middle right : Carrier}
      (firstLeg : EquationalTheory rel left middle) (secondLeg : EquationalTheory rel middle right) :
      EquationalTheory rel left right

/-- A reduction is a conversion: `ReflTransClosure rel ⊆ EquationalTheory rel`. -/
theorem EquationalTheory.ofReduction {rel : Carrier → Carrier → Prop} {source target : Carrier}
    (chain : ReflTransClosure rel source target) : EquationalTheory rel source target := by
  induction chain with
  | refl point => exact EquationalTheory.refl point
  | head first _rest inductionHypothesis =>
      exact EquationalTheory.trans (EquationalTheory.rule first) inductionHypothesis

/-- Joinable terms are convertible: `Joinable rel ⊆ EquationalTheory rel` (reduce both to the common reduct,
one leg reversed). -/
theorem EquationalTheory.ofJoinable {rel : Carrier → Carrier → Prop} {leftValue rightValue : Carrier}
    (joinable : Joinable rel leftValue rightValue) : EquationalTheory rel leftValue rightValue := by
  obtain ⟨commonReduct, leftToCommon, rightToCommon⟩ := joinable
  exact EquationalTheory.trans (EquationalTheory.ofReduction leftToCommon)
    (EquationalTheory.symm (EquationalTheory.ofReduction rightToCommon))

/-- ★ **The Church-Rosser theorem (abstract).**  For a CONFLUENT relation, the equational theory `⟷*` is
exactly JOINABILITY `↓` — two terms are convertible iff they reduce to a common reduct.  Forward by
induction on the conversion, closing the `trans` peak `leftMeet ⟸ middle ⟹ rightMeet` with confluence;
backward is `EquationalTheory.ofJoinable`. -/
theorem churchRosser_of_confluent {rel : Carrier → Carrier → Prop} (confluent : Confluent rel)
    {leftValue rightValue : Carrier} :
    EquationalTheory rel leftValue rightValue ↔ Joinable rel leftValue rightValue := by
  constructor
  · intro conversion
    induction conversion with
    | rule step => exact ⟨_, ReflTransClosure.single step, ReflTransClosure.refl _⟩
    | refl point => exact ⟨point, ReflTransClosure.refl point, ReflTransClosure.refl point⟩
    | symm _conv inductionHypothesis =>
        obtain ⟨commonReduct, leftToCommon, rightToCommon⟩ := inductionHypothesis
        exact ⟨commonReduct, rightToCommon, leftToCommon⟩
    | trans _firstLeg _secondLeg firstJoinable secondJoinable =>
        obtain ⟨leftMeet, leftToLeftMeet, middleToLeftMeet⟩ := firstJoinable
        obtain ⟨rightMeet, middleToRightMeet, rightToRightMeet⟩ := secondJoinable
        obtain ⟨peak, leftMeetToPeak, rightMeetToPeak⟩ := confluent middleToLeftMeet middleToRightMeet
        exact ⟨peak, leftToLeftMeet.trans leftMeetToPeak, rightToRightMeet.trans rightMeetToPeak⟩
  · exact EquationalTheory.ofJoinable

/-- ★ **The Knuth-Bendix convergence criterion.**  A TERMINATING, LOCALLY CONFLUENT relation (`terminating`
+ `WeaklyConfluent`, i.e. all critical pairs joinable) DECIDES its equational theory: `a ⟷* b ↔ a↓b`.
Newman lifts local to global confluence; Church-Rosser then equates `⟷*` with joinability — the payoff a
successful completion delivers. -/
theorem knuthBendixConvergenceCriterion {rel : Carrier → Carrier → Prop}
    (terminating : WellFounded (fun reduct origin => rel origin reduct))
    (locallyConfluent : WeaklyConfluent rel) {leftValue rightValue : Carrier} :
    EquationalTheory rel leftValue rightValue ↔ Joinable rel leftValue rightValue :=
  churchRosser_of_confluent (newman terminating locallyConfluent)

/-- ★ **Orientation soundness (completion preserves the theory).**  The equational theory of a relation
equals that of its symmetrization — so orienting an equation `s = t` into a rule (in either direction) does
NOT change `⟷*`.  This is why every completion inference step is theory-preserving. -/
theorem equationalTheory_orientationInvariant {rel : Carrier → Carrier → Prop}
    {leftValue rightValue : Carrier} :
    EquationalTheory rel leftValue rightValue
      ↔ EquationalTheory (fun source target => rel source target ∨ rel target source)
          leftValue rightValue := by
  constructor
  · intro conversion
    induction conversion with
    | rule step => exact EquationalTheory.rule (Or.inl step)
    | refl point => exact EquationalTheory.refl point
    | symm _conv inductionHypothesis => exact EquationalTheory.symm inductionHypothesis
    | trans _firstLeg _secondLeg firstInductionHypothesis secondInductionHypothesis =>
        exact EquationalTheory.trans firstInductionHypothesis secondInductionHypothesis
  · intro conversion
    induction conversion with
    | rule step =>
        exact step.elim EquationalTheory.rule
          (fun reverse => EquationalTheory.symm (EquationalTheory.rule reverse))
    | refl point => exact EquationalTheory.refl point
    | symm _conv inductionHypothesis => exact EquationalTheory.symm inductionHypothesis
    | trans _firstLeg _secondLeg firstInductionHypothesis secondInductionHypothesis =>
        exact EquationalTheory.trans firstInductionHypothesis secondInductionHypothesis

/-! ## A concrete witness — the criterion is non-vacuous on a real convergent rule -/

/-- The single rewrite rule `true ↦ false` (a one-rule terminating system over `Bool`). -/
inductive OneRuleStep : Bool → Bool → Prop where
  /-- The only rule. -/
  | trueToFalse : OneRuleStep true false

/-- The one-rule system terminates: `false` is a normal form, `true` reduces only to it. -/
theorem oneRuleStep_terminating :
    WellFounded (fun reduct origin => OneRuleStep origin reduct) := by
  have accFalse : Acc (fun reduct origin => OneRuleStep origin reduct) false :=
    Acc.intro false (fun _predecessor step => by cases step)
  refine ⟨fun value => ?_⟩
  cases value with
  | false => exact accFalse
  | true => exact Acc.intro true (fun _predecessor step => by cases step; exact accFalse)

/-- The one-rule system is locally confluent (its single rule has no overlaps / critical pairs). -/
theorem oneRuleStep_weaklyConfluent : WeaklyConfluent OneRuleStep := by
  intro _source _leftStep _rightStep stepLeft stepRight
  cases stepLeft
  cases stepRight
  exact ⟨false, ReflTransClosure.refl false, ReflTransClosure.refl false⟩

/-- ★ The one-rule system `{true ↦ false}` is CONVERGENT, so the KB criterion decides its theory: `a ⟷* b`
iff `a` and `b` reduce to a common normal form.  A non-vacuous instance of `knuthBendixConvergenceCriterion`
on a genuine rewrite rule. -/
theorem oneRuleConvergent {leftValue rightValue : Bool} :
    EquationalTheory OneRuleStep leftValue rightValue ↔ Joinable OneRuleStep leftValue rightValue :=
  knuthBendixConvergenceCriterion oneRuleStep_terminating oneRuleStep_weaklyConfluent

end FX1Poly.Core

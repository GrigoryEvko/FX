import FX1Poly.Core.StepRewriteRuleMap
import FX1Poly.Core.TableReduceOnce

/-! # TableRewriteRuleMap — IOTA-T9: the rewrite-rule system DERIVED
from the table

The fifth consumer-migration brick: the FX rewriting system over the
term-code word alphabet re-based onto the table relation.  The bespoke
`fxStepSystem` is generated by the bespoke `Step`; the table system
`fxTableSystem` is generated by `StepTable` — and the bespoke system is
PROVABLY a sub-system (every bespoke reduction is a legacy-table step,
and legacy rows are full-table rows), so every SN-130-style fact about
the generated system becomes a corollary of the table formulation.  The
inclusion is STRICT in content: the table-native endpoint-β contributes
rules with no bespoke counterpart, witnessed by the pathBeta firing
pinned in `TableReduceOnce`.

Zero-axiom: no `sorry`, no `propext`, no `Quot.sound`, no `Classical`,
`native_decide`, `omega`.  Per-declaration audit-gated in
`FX1PolyAudit/AuditTableRewriteRuleMap.lean`. -/

namespace FX1Poly.Core

/-! ## The table-generated system -/

/-- The rewrite-rule system a TABLE relation generates: a rule belongs
iff it is the term-code pair of some `StepOverTable` reduction. -/
def fxSystemOverTable (table : List IotaRuleDesc)
    (rule : FxTermRewriteRule) : Prop :=
  ∃ (scope : Nat) (redex reduct : RawTerm scope),
    StepOverTable table redex reduct
      ∧ rule.leftHandSide = redex.toCode
      ∧ rule.rightHandSide = reduct.toCode

/-- **THE canonical rewrite system**: the rules `StepTable` generates —
the table-derived replacement of the bespoke `fxStepSystem`. -/
def fxTableSystem (rule : FxTermRewriteRule) : Prop :=
  fxSystemOverTable iotaRuleTable rule

/-- The table-step → rule map. -/
def StepOverTable.inducedRewriteRule {table : List IotaRuleDesc}
    {scope : Nat} {redex reduct : RawTerm scope}
    (_tableStep : StepOverTable table redex reduct) : FxTermRewriteRule where
  leftHandSide := redex.toCode
  rightHandSide := reduct.toCode

/-- Every table reduction's induced rule is a rule of its table's
system. -/
theorem StepOverTable.inducedRewriteRule_mem_fxSystemOverTable
    {table : List IotaRuleDesc} {scope : Nat} {redex reduct : RawTerm scope}
    (tableStep : StepOverTable table redex reduct) :
    fxSystemOverTable table tableStep.inducedRewriteRule :=
  ⟨scope, redex, reduct, tableStep, rfl, rfl⟩

/-! ## The bespoke system is a sub-system — SN-130 facts become
corollaries -/

/-- **The bespoke `fxStepSystem` is contained in the canonical table
system**: every bespoke reduction is a legacy-table step (IOTA-T1
adequacy), and every legacy row is a full-table row.  Facts about the
generated rewrite system migrate to the table formulation wholesale. -/
theorem fxStepSystem_subset_fxTableSystem {rule : FxTermRewriteRule}
    (isBespokeRule : fxStepSystem rule) : fxTableSystem rule := by
  obtain ⟨scope, redex, reduct, step, leftEq, rightEq⟩ := isBespokeRule
  exact ⟨scope, redex, reduct,
    StepOverTable.monotone (fun isLegacy => legacyRow_memFullTable isLegacy)
      step.toLegacyTableStep,
    leftEq, rightEq⟩

/-! ## The inclusion is strict in content: endpoint-β contributes -/

/-- The endpoint-β redex `pathApp(pathLam(var 0), refl(unit))` at
scope 0 — the table-native firing's source. -/
def pathBetaRuleFixtureRedex : RawTerm 0 :=
  .mkGen .gen_pathApp ()
    (.childCons
      (.mkGen .gen_pathLam ()
        (.childCons
          (.mkGen .gen_var ⟨0, Nat.zero_lt_succ 0⟩ .childNil)
          .childNil))
      (.childCons
        (.mkGen .gen_refl ()
          (.childCons (.mkGen .gen_unit () .childNil) .childNil))
        .childNil))

/-- Its reduct. -/
def pathBetaRuleFixtureReduct : RawTerm 0 :=
  .mkGen .gen_refl ()
    (.childCons (.mkGen .gen_unit () .childNil) .childNil)

/-- **The table system contains the endpoint-β rule** — a rule with NO
bespoke `Step` counterpart anywhere, witnessed by the canonical
reducer's pathBeta firing.  The table system genuinely EXTENDS the
bespoke one; the flip is not a renaming. -/
theorem fxTableSystem_containsPathBetaRule :
    fxTableSystem
      ⟨pathBetaRuleFixtureRedex.toCode, pathBetaRuleFixtureReduct.toCode⟩ :=
  ⟨0, pathBetaRuleFixtureRedex, pathBetaRuleFixtureReduct,
    StepTable.reduceOnce_sound StepTable.reduceOnce_firesPathBeta,
    rfl, rfl⟩

end FX1Poly.Core

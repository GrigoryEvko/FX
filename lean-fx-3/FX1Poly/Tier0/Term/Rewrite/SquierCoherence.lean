/-! # Tier0/Term — Squier coherence: the proof-relevant rewriting 2-category (term-4)

`term-2` built the dim-1 rewriting layer as a `Prop`-valued PREORDER (a thin category — all parallel
reduction paths collapse by proof irrelevance), and flagged that the proof-RELEVANT 1-cells, with
critical-pair 2-cells, are `term-4`.  That bill comes due here: Squier's homotopical theorem needs paths
to be DATA (distinct reduction sequences are distinct 2-cells), because coherence is a statement ABOUT
the relations among paths — vacuous if paths are a `Prop`.

This file builds the genuine proof-relevant rewriting 2-category and the homotopy congruence (the
2-cells), abstractly over a Type-valued step relation — the canonical-instance approach (`term-3`'s
streams, `term-2`'s generic closure).  The FX instantiation — the critical-pair complex over the
205-generator table, and the syntactic-congruence generation — is the deferred capstone (the FX rule
bundle is ORTHOGONAL: `fxRewriteBundle_rowsDisjoint = true`, no critical pairs, so its homotopy basis is
the DISJOINT-REDEX / diamond cells, not critical-pair cells; the homology connection is `OHOM-1` / `term-5`).

## What this file ships (each zero-axiom)

  * **`RewritePath Step`** — proof-relevant reduction sequences (`nil` / `cons`): the 1-cells of the
    rewriting 2-category, now DATA (the non-thin lift of `term-2`).
  * **`RewritePath.comp`** + **`nil_comp` / `comp_nil` / `comp_assoc`** — vertical composition and the
    GENUINE category laws (real structural inductions, not proof irrelevance — what `term-2` could only
    do thinly).
  * **`SquierDiamond Step`** — the generating confluences as DATA: every local peak `b ⟸ a ⟹ c` is
    filled by a diamond to a common apex (the disjoint-redex / orthogonal-confluence cells).
  * **`RewriteHomotopy dp`** — the 2-cells: the congruence on parallel paths generated by the diamond
    cells, closed under `refl` / `symm` / `trans` (equivalence) and `whiskerLeft` / `whiskerRight`
    (the 2-category interchange whiskerings).
  * **`RewriteHomotopy.whiskerLeftPath` / `whiskerRightPath`** — whiskering by whole paths (the
    congruence is compatible with vertical composition on both sides).

The coherence theorem proper (the diamond cells are a homotopy basis: any two parallel paths to a normal
form are homotopic) is built on this in the companion development; here is the 2-category + congruence
substrate it rests on.

## Zero-axiom verification

Two inductives, structural recursion (`comp`) + `rfl`/structural-induction category laws (no
`List.append_assoc`, which leaks `propext` in this Init-only setting), and induction over the homotopy
congruence.  No `axiom`, `sorry`, `propext`, `Quot.sound`, `Classical`, `native_decide`, or `omega`.
Per-declaration gated in `FX1PolyAudit/AuditTier0TermSquier.lean`.
-/

namespace FX1Poly.Core

variable {Carrier : Type}

/-- **Proof-relevant rewriting paths**: a reduction sequence as DATA — `nil` (the identity path) and
`cons` (a step followed by a path).  Distinct sequences are distinct values, so these are the genuine
(non-thin) 1-cells of the rewriting 2-category, unlike `term-2`'s `Prop`-valued closure. -/
inductive RewritePath (Step : Carrier → Carrier → Type) : Carrier → Carrier → Type where
  /-- The identity path (zero steps). -/
  | nil {point : Carrier} : RewritePath Step point point
  /-- A step followed by the rest of the path. -/
  | cons {source middle target : Carrier}
      (firstStep : Step source middle) (rest : RewritePath Step middle target) :
      RewritePath Step source target

/-- The length-one path of a single step. -/
def RewritePath.single {Step : Carrier → Carrier → Type} {source target : Carrier}
    (step : Step source target) : RewritePath Step source target :=
  .cons step .nil

/-- **Vertical composition** of paths (concatenation), by structural recursion on the first path. -/
def RewritePath.comp {Step : Carrier → Carrier → Type} :
    {source middle target : Carrier} →
    RewritePath Step source middle → RewritePath Step middle target → RewritePath Step source target
  | _, _, _, .nil, secondPath => secondPath
  | _, _, _, .cons firstStep restPath, secondPath => .cons firstStep (restPath.comp secondPath)

/-- Left identity for composition (by `rfl`). -/
theorem RewritePath.nil_comp {Step : Carrier → Carrier → Type} {source target : Carrier}
    (path : RewritePath Step source target) : (RewritePath.nil).comp path = path := rfl

/-- `cons` distributes over composition (by `rfl`). -/
theorem RewritePath.cons_comp {Step : Carrier → Carrier → Type}
    {source middle inner target : Carrier} (step : Step source middle)
    (restPath : RewritePath Step middle inner) (secondPath : RewritePath Step inner target) :
    (RewritePath.cons step restPath).comp secondPath = .cons step (restPath.comp secondPath) := rfl

/-- Right identity for composition (by structural induction). -/
theorem RewritePath.comp_nil {Step : Carrier → Carrier → Type} {source target : Carrier}
    (path : RewritePath Step source target) : path.comp .nil = path := by
  induction path with
  | nil => rfl
  | cons step restPath inductionHypothesis =>
    show RewritePath.cons step (restPath.comp .nil) = .cons step restPath
    rw [inductionHypothesis]

/-- Associativity of composition (by structural induction on the first path). -/
theorem RewritePath.comp_assoc {Step : Carrier → Carrier → Type}
    {source middle inner target : Carrier}
    (firstPath : RewritePath Step source middle) (secondPath : RewritePath Step middle inner)
    (thirdPath : RewritePath Step inner target) :
    (firstPath.comp secondPath).comp thirdPath = firstPath.comp (secondPath.comp thirdPath) := by
  induction firstPath with
  | nil => rfl
  | cons step restPath inductionHypothesis =>
    show RewritePath.cons step ((restPath.comp secondPath).comp thirdPath)
          = .cons step (restPath.comp (secondPath.comp thirdPath))
    rw [inductionHypothesis]

/-- The **generating confluences** as DATA — the DIAMOND PROPERTY: every local peak `b ⟸ a ⟹ c`
(two steps out of a common source) is filled by a diamond to a common `apex`, with the two residual
steps `joinLeft` (continuing from `b`) and `joinRight` (continuing from `c`).  For the orthogonal FX
bundle these are the disjoint-redex / parallel-reduction residuals (no critical-pair overlaps). -/
structure SquierDiamond (Step : Carrier → Carrier → Type) where
  /-- The common reduct of a local peak. -/
  apex : ∀ {source left right : Carrier}, Step source left → Step source right → Carrier
  /-- The residual step continuing from the left reduct to the apex. -/
  joinLeft : ∀ {source left right : Carrier} (leftStep : Step source left) (rightStep : Step source right),
    Step left (apex leftStep rightStep)
  /-- The residual step continuing from the right reduct to the apex. -/
  joinRight : ∀ {source left right : Carrier} (leftStep : Step source left) (rightStep : Step source right),
    Step right (apex leftStep rightStep)

/-- The **2-cells**: the homotopy congruence on parallel rewriting paths generated by the diamond
confluence cells.  Closed under `refl` / `symm` / `trans` (an equivalence on each hom) and
`whiskerLeft` / `whiskerRight` (compatibility with vertical composition) — the (2,1)-category generated
by the generating confluences. -/
inductive RewriteHomotopy {Step : Carrier → Carrier → Type} (dp : SquierDiamond Step) :
    {source target : Carrier} → RewritePath Step source target → RewritePath Step source target → Prop where
  /-- The generating diamond cell: the two legs of a local-peak confluence are homotopic. -/
  | diamond {source left right : Carrier} (leftStep : Step source left) (rightStep : Step source right) :
      RewriteHomotopy dp
        (.cons leftStep (.single (dp.joinLeft leftStep rightStep)))
        (.cons rightStep (.single (dp.joinRight leftStep rightStep)))
  /-- Reflexivity. -/
  | refl {source target : Carrier} (path : RewritePath Step source target) :
      RewriteHomotopy dp path path
  /-- Symmetry. -/
  | symm {source target : Carrier} {leftPath rightPath : RewritePath Step source target} :
      RewriteHomotopy dp leftPath rightPath → RewriteHomotopy dp rightPath leftPath
  /-- Transitivity (vertical composition of 2-cells). -/
  | trans {source target : Carrier} {firstPath middlePath lastPath : RewritePath Step source target} :
      RewriteHomotopy dp firstPath middlePath → RewriteHomotopy dp middlePath lastPath →
      RewriteHomotopy dp firstPath lastPath
  /-- Left whiskering by a single step. -/
  | whiskerLeft {source middle target : Carrier} (step : Step source middle)
      {leftPath rightPath : RewritePath Step middle target} :
      RewriteHomotopy dp leftPath rightPath →
      RewriteHomotopy dp (.cons step leftPath) (.cons step rightPath)
  /-- Right whiskering by a path. -/
  | whiskerRight {source middle target : Carrier}
      {leftPath rightPath : RewritePath Step source middle} :
      RewriteHomotopy dp leftPath rightPath → (suffix : RewritePath Step middle target) →
      RewriteHomotopy dp (leftPath.comp suffix) (rightPath.comp suffix)

/-- Left whiskering by a whole PATH (compatibility of the homotopy with composition on the left), by
induction on the prefix path. -/
theorem RewriteHomotopy.whiskerLeftPath {Step : Carrier → Carrier → Type} {dp : SquierDiamond Step}
    {middle target : Carrier} {leftPath rightPath : RewritePath Step middle target}
    (homotopy : RewriteHomotopy dp leftPath rightPath) :
    ∀ {source : Carrier} (prefixPath : RewritePath Step source middle),
      RewriteHomotopy dp (prefixPath.comp leftPath) (prefixPath.comp rightPath) := by
  intro source prefixPath
  induction prefixPath with
  | nil => exact homotopy
  | cons step _restPath inductionHypothesis =>
    exact RewriteHomotopy.whiskerLeft step (inductionHypothesis homotopy)

/-- Right whiskering by a path, packaged as a function (the constructor with the suffix explicit). -/
theorem RewriteHomotopy.whiskerRightPath {Step : Carrier → Carrier → Type} {dp : SquierDiamond Step}
    {source middle target : Carrier} {leftPath rightPath : RewritePath Step source middle}
    (homotopy : RewriteHomotopy dp leftPath rightPath) (suffix : RewritePath Step middle target) :
    RewriteHomotopy dp (leftPath.comp suffix) (rightPath.comp suffix) :=
  RewriteHomotopy.whiskerRight homotopy suffix

/-! ## The coherence theorem (diamond case): the generating confluences are a homotopy basis -/

/-- A **coherent confluence** of two coinitial paths: a common apex, the two completing legs, AND the
2-cell witnessing that the two ways around the square are homotopic (built from the diamond cells).  The
proof-relevant confluence diagram of Squier. -/
structure SquierConfluence {Step : Carrier → Carrier → Type} (dp : SquierDiamond Step)
    {source leftEnd rightEnd : Carrier}
    (leftPath : RewritePath Step source leftEnd) (rightPath : RewritePath Step source rightEnd) where
  /-- The common reduct. -/
  apex : Carrier
  /-- The leg completing the left path to the apex. -/
  leftLeg : RewritePath Step leftEnd apex
  /-- The leg completing the right path to the apex. -/
  rightLeg : RewritePath Step rightEnd apex
  /-- The 2-cell: the two ways around the square are homotopic (generated by the diamond cells). -/
  coherent : RewriteHomotopy dp (leftPath.comp leftLeg) (rightPath.comp rightLeg)

/-- ★ **The strip lemma (coherent).**  A single step and a path out of a common source confluently join,
WITH a homotopy witness built from the diamond cells.  By structural recursion on the path. -/
def SquierDiamond.strip {Step : Carrier → Carrier → Type} (dp : SquierDiamond Step)
    {source leftEnd rightEnd : Carrier}
    (firstStep : Step source leftEnd) (path : RewritePath Step source rightEnd) :
    SquierConfluence dp (RewritePath.single firstStep) path :=
  match path with
  | .nil =>
    { apex := leftEnd
      leftLeg := .nil
      rightLeg := .single firstStep
      coherent := by
        rw [RewritePath.comp_nil]
        exact RewriteHomotopy.refl _ }
  | .cons nextStep restPath =>
    let inner := dp.strip (dp.joinRight firstStep nextStep) restPath
    { apex := inner.apex
      leftLeg := (RewritePath.single (dp.joinLeft firstStep nextStep)).comp inner.leftLeg
      rightLeg := inner.rightLeg
      coherent := by
        rw [← RewritePath.comp_assoc]
        refine RewriteHomotopy.trans
          ((RewriteHomotopy.diamond firstStep nextStep).whiskerRightPath inner.leftLeg) ?_
        exact RewriteHomotopy.whiskerLeft nextStep inner.coherent }

/-- ★ **Coherent confluence.**  Any two coinitial paths confluently join, WITH a homotopy witness built
from the diamond cells — the proof-relevant Church-Rosser of the diamond system.  By structural recursion
on the first path, using the strip lemma. -/
def SquierDiamond.confluent {Step : Carrier → Carrier → Type} (dp : SquierDiamond Step)
    {source leftEnd rightEnd : Carrier}
    (leftPath : RewritePath Step source leftEnd) (rightPath : RewritePath Step source rightEnd) :
    SquierConfluence dp leftPath rightPath :=
  match leftPath with
  | .nil =>
    { apex := rightEnd
      leftLeg := rightPath
      rightLeg := .nil
      coherent := by
        rw [RewritePath.comp_nil]
        exact RewriteHomotopy.refl _ }
  | .cons firstStep restPath =>
    let stripped := dp.strip firstStep rightPath
    let inner := dp.confluent restPath stripped.leftLeg
    { apex := inner.apex
      leftLeg := inner.leftLeg
      rightLeg := stripped.rightLeg.comp inner.rightLeg
      coherent := by
        refine RewriteHomotopy.trans (RewriteHomotopy.whiskerLeft firstStep inner.coherent) ?_
        rw [← RewritePath.comp_assoc]
        exact stripped.coherent.whiskerRightPath inner.rightLeg }

/-- ★ **Squier coherence (diamond case): the confluence diamonds are a homotopy basis.**  Any two
parallel reduction paths INTO A NORMAL FORM are homotopic — equal modulo the generating confluence cells.
This is the genuine coherent-presentation statement: the 2-cells filling the local branchings generate
ALL the homotopy between parallel normalization paths.  (From a normal form there is no step, so the
confluence legs are empty and the coherent square collapses to `leftPath ≃ rightPath`.) -/
theorem SquierDiamond.coherence {Step : Carrier → Carrier → Type} (dp : SquierDiamond Step)
    {source target : Carrier} (isNormalForm : ∀ next, Step target next → False)
    (leftPath rightPath : RewritePath Step source target) :
    RewriteHomotopy dp leftPath rightPath := by
  obtain ⟨apex, leftLeg, rightLeg, coherent⟩ := dp.confluent leftPath rightPath
  match leftLeg, rightLeg with
  | .nil, .nil =>
    rw [RewritePath.comp_nil, RewritePath.comp_nil] at coherent
    exact coherent
  | .nil, .cons rightStep _ => exact (isNormalForm _ rightStep).elim
  | .cons leftStep _, _ => exact (isNormalForm _ leftStep).elim

end FX1Poly.Core

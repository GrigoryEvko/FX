import FX1Poly.Typed.Dimensions.Parametricity.GelIsTranspensionAtAffine
import FX1Poly.Core.Rewriting.RuleTables.Iota.IotaRuleTable

/-! # FX1Poly/Typed/Dimensions/Parametricity/TranspensionSchema
    — the internal derivation, table-native: the kernel's transpension rows are ONE parametric row-family

This REVERSES the timid `equalityTier` classification (rows that merely SHARE a structure-class).  The
table-native internal derivation is generative: gel / glue / nominal are not separate rows — they are ONE
parametric ROW-SCHEMA instantiated at different `mode-2` structure-classes, and the recovery
"gel = transpension @ affine" is a DEFINITIONAL fact: the shipped `gelBetaIotaRow` is GENERATED by the
schema at the affine class, by `rfl`.

This is NOT Nuyts' semantic-adjoint recovery (build a universal adjoint, recover the zoo by a semantic
construction — hard / open, the route Nuyts could not make computational).  It is the FX-native ROW-SCHEMA
derivation: the kernel ROWS are one parametric object, and the recoveries are `rfl`.  The universal object
is the row-schema, not a bespoke adjoint — which is precisely why a TABLE-DRIVEN kernel can do internally
what Nuyts deferred.

## Honest scope

Only the AFFINE slot is LIVE (the shipped Gel rows).  `cartesian` / `dedekind` / `deMorgan` are reserved
(`none`) until glue / etc. go live (`TRANSP-GLUE` fills cartesian, `TRANSP-NOMINAL` adds the nullary arity).
So this is the internal derivation for 1 of 4 structure-classes — schema-level, with liveness-promotion
filling the rest.  The schema EXISTS for all four; only its affine output is realized as shipped rows.

## Zero-axiom verification

The reconstruction is `Option.map` over a concrete schema (`rfl`); the discriminate is `Option.noConfusion`;
the liveness ledger is `List.filter`/`isSome` reducing by `rfl`.  No `axiom`, `sorry`, `propext`,
`Quot.sound`, `Classical`, `native_decide`, `omega`.  Per-decl audit-gated in
`FX1PolyAudit/AuditTranspensionSchema.lean`.
-/

namespace FX1Poly.Typed

open FX1Poly.Axis
open FX1Poly.Core

/-! ## The schema -/

/-- The kernel data one transpension instance contributes: the constructor (intro) generator, the
eliminator generator, and the β-reduct template.  The "shape of a transpension former @ a structure-class"
as kernel rows. -/
structure TranspensionInstanceData where
  /-- The constructor head (e.g. `gen_gel`). -/
  introGenerator : Generator
  /-- The eliminator head (e.g. `gen_ungel`). -/
  elimGenerator : Generator
  /-- The β-reduct template (e.g. `.scrutineeChildAt 0 2`, the relation-witness projection). -/
  betaTarget : ReductTemplate

/-- Reconstruct the β iota row from an instance's data: `elim (intro …) ↝ betaTarget`, the single
left-linear scrutinee being the intro at slot 0 (`motiveSlot?` / `typedOutputTemplate?` default to `none`,
the non-dependent-projection shape). -/
def instanceToIotaRow (instanceData : TranspensionInstanceData) : IotaRuleDesc where
  elimGenerator := instanceData.elimGenerator
  scrutinees := [{ slot := 0, head := instanceData.introGenerator }]
  target := instanceData.betaTarget

/-- The affine (parametricity / Gel) instance: `ungel (gel a b r) ↝ r` — the shipped gel-β data. -/
def gelInstanceData : TranspensionInstanceData where
  introGenerator := .gen_gel
  elimGenerator := .gen_ungel
  betaTarget := .scrutineeChildAt 0 2

/-- ★ **THE TRANSPENSION ROW-SCHEMA** — ONE parametric object mapping a `mode-2` structure-class to its
kernel instance (when live).  gel / glue / nominal are this ONE schema at different structure-classes;
`affine` is the live slot (the shipped Gel rows), the rest are reserved (`none`) until those operators go
live.  This is the universal object of the internal derivation — a row-function, not an adjoint. -/
def transpensionInstanceAt : MultiplierStructureClass → Option TranspensionInstanceData
  | .affine => some gelInstanceData
  | .cartesian => none
  | .dedekind => none
  | .deMorgan => none

/-! ## ★ The internal derivation — the shipped gel-β row IS the schema at affine -/

/-- ★★ **The internal derivation (table-native).**  The SHIPPED `gelBetaIotaRow` is GENERATED by the
row-schema instantiated at the affine structure-class — definitionally, by `rfl`.  "gel = transpension @
affine" is therefore an INTERNAL fact (the gel row RECONSTRUCTS exactly from the schema), not a meta-level
classification.  The `rfl` links this module's schema to the row defined in `IotaRuleTable.lean`; had the
schema mis-specified the generators or the β-target, it would FAIL — so it is genuine content, not a
tautology. -/
theorem gelBetaIotaRow_isGeneratedBySchemaAtAffine :
    (transpensionInstanceAt .affine).map instanceToIotaRow = some gelBetaIotaRow := rfl

/-- The schema at the rung-1 `gelStructureClass` (which is `.affine`) is the gel instance — tying the
generative schema to the descriptive rung-1 classification. -/
theorem schemaAtGelStructureClass :
    transpensionInstanceAt gelStructureClass = some gelInstanceData := rfl

/-- ★ The schema at affine generates not merely the row DATA but the row that COMPUTES: it reconstructs
exactly `gelBetaIotaRow`, AND that row fires as a real `Step` — for every gel cell,
`ungel (gel a b r) ↝ r`.  This links the schema to the OPERATIONAL semantics (a genuine reduction), not
just the row's data.  (The reduction is the shipped `ungelGelStep`; the link is the reconstruction.) -/
theorem schemaAffineRowComputes {scope : Nat}
    (leftEndpoint rightEndpoint relationWitness : RawTerm scope) :
    (transpensionInstanceAt .affine).map instanceToIotaRow = some gelBetaIotaRow
      ∧ Step (ungelProjection (gelCellOf leftEndpoint rightEndpoint relationWitness)) relationWitness :=
  ⟨rfl, ungelGelStep leftEndpoint rightEndpoint relationWitness⟩

/-! ## Non-vacuity — the schema genuinely varies -/

/-- The schema is NOT constant: the affine slot is live (`some`), the cartesian slot is reserved (`none`).
Mirrors the discriminate guards of the sibling classifiers. -/
theorem transpensionSchema_discriminates :
    transpensionInstanceAt .affine ≠ transpensionInstanceAt .cartesian := by
  intro slotsEqual
  have isSomeMismatch : true = false := congrArg Option.isSome slotsEqual
  exact Bool.noConfusion isSomeMismatch

/-! ## The honest liveness ledger -/

/-- Whether the schema is LIVE at a structure-class (an operator's rows are shipped). -/
def transpensionInstanceIsLive (structureClass : MultiplierStructureClass) : Bool :=
  (transpensionInstanceAt structureClass).isSome

/-- The affine slot is live (the shipped Gel rows). -/
theorem affineInstanceIsLive : transpensionInstanceIsLive .affine = true := rfl

/-- The cartesian slot is reserved (glue not yet instantiated). -/
theorem cartesianInstanceIsReserved : transpensionInstanceIsLive .cartesian = false := rfl

/-- ★ Honest ledger: EXACTLY ONE of the four structure-classes is live so far (`affine` = Gel).  The schema
EXISTS for all four; liveness-promotion (`TRANSP-GLUE` for cartesian, `TRANSP-NOMINAL` for the nullary
arity) fills the rest. -/
theorem liveStructureClassCount :
    ([MultiplierStructureClass.affine, .cartesian, .dedekind, .deMorgan].filter
      transpensionInstanceIsLive).length = 1 := rfl

/-! ## Honest rails -/

/-- **Honesty marker.**  The internal derivation here is the table-native ROW-SCHEMA derivation (the kernel
rows are one parametric family; recoveries are `rfl`).  `= true` — it IS done for the live (affine) slot. -/
def fxTranspension_internalDerivationIsRowSchema : Bool := true

/-- **Honesty marker.**  This is NOT Nuyts' semantic-adjoint recovery (a universal adjoint deriving the zoo
by semantic construction — `mode-11`'s `fxMode_hasTranspensionZooRecovery`, still that separate, hard
program).  `= false`. -/
def fxTranspension_isSemanticAdjointRecovery : Bool := false

/-- **Honesty marker.**  Not all four structure-classes are live — only `affine` (Gel); the schema's other
slots are reserved (`none`).  `= false`. -/
def fxTranspension_allStructureClassesLive : Bool := false

end FX1Poly.Typed
